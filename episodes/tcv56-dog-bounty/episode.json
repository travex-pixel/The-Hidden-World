 "claims": [
  {
   "id": "D_hook",
   "type": "established",
   "nature": "fact",
   "text": "In July 2018 Colombian police said the Gulf Clan (Clan del Golfo / Urabenos) had put a price on the head of Sombra, a police drug-detection dog. Narration: 'A cartel put a bounty on a dog.'",
   "sources": [
    "cbs",
    "npr",
    "wtkr",
    "ap_fox",
    "global",
    "espect",
    "heraldo"
   ]
  },
  {
   "id": "D_amount",
   "type": "established",
   "nature": "reported",
   "text": "REPORTED, DISPUTED: CNN/CBS, NPR and BuzzFeed (citing Colombian police) reported a bounty of up to 200 million pesos, nearly $70,000; AP (NBC) and BBC Mundo/RPP (citing the anti-narcotics directorate) reported 20 million pesos, about $7,000. Narration: 'Reportedly up to $70,000.' The range is shown on a card in s05.",
   "sources": [
    "cbs",
    "npr",
    "buzz",
    "espect",
    "nbc",
    "rpp",
    "bbcm"
   ]
  },
  {
   "id": "D_meet",
   "type": "established",
   "nature": "fact",
   "text": "Sombra is a female German Shepherd (six years old in 2018) of the Colombian National Police's anti-narcotics directorate, with the force since she was a puppy. Narration: 'This is Sombra, a German Shepherd.'",
   "sources": [
    "cbs",
    "npr",
    "wtkr",
    "ap_fox",
    "global",
    "espect2"
   ]
  },
  {
   "id": "D_job",
   "type": "established",
   "nature": "fact",
   "text": "She is a drug-detection (sniffer) dog that searches for cocaine. Narration: 'Her job? Sniffing out cocaine in Colombia.'",
   "sources": [
    "cbs",
    "npr",
    "wtkr",
    "ap_fox",
    "global"
   ]
  },
  {
   "id": "D_name",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: 'Sombra' means 'shadow' in Spanish (AP; Spanish dictionary meaning).",
   "sources": [
    "ap_fox",
    "ap_arab",
    "buzz"
   ]
  },
  {
   "id": "D_port",
   "type": "established",
   "nature": "fact",
   "text": "At the port of Turbo (Uraba, Antioquia) she found tonnes of cocaine (Spanish press: about 5.3 tonnes bound for Europe, then about 4 tonnes hidden in car parts; police total over three years about nine tons; AP: over 2,000 kg). Narration: 'At the port of Turbo, she found tonnes of it.'",
   "sources": [
    "heraldo",
    "eju",
    "blu",
    "espect",
    "cbs_tx",
    "cbs"
   ]
  },
  {
   "id": "D_clan",
   "type": "established",
   "nature": "fact",
   "text": "Much of what she found belonged to the Gulf Clan (El Heraldo: 'more than 5 tonnes of the criminal group's cocaine'; eju: she 'made the Clan del Golfo lose tonnes of cocaine'). Narration: 'Who owned much of it? The Gulf Clan.'",
   "sources": [
    "heraldo",
    "eju",
    "espect",
    "wtkr"
   ]
  },
  {
   "id": "D_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): police credited her work with 245 arrests, at the Jose Maria Cordova (Rionegro, serving Medellin) and El Dorado (Bogota) airports. Narration: 'At airports, her nose led to 245 arrests.'",
   "sources": [
    "cbs",
    "wtkr",
    "global",
    "espect",
    "heraldo"
   ]
  },
  {
   "id": "D_cost",
   "type": "established",
   "nature": "reported",
   "text": "REPORTED: a police spokesperson told The Telegraph that the high reward showed the impact she had had on the gang's profits. Narration (paraphrase, no quote): 'Police said the price showed what she cost them.'",
   "sources": [
    "buzz",
    "cbs_tx",
    "cbs_phl"
   ]
  },
  {
   "id": "D_range",
   "type": "established",
   "nature": "fact",
   "text": "Card: reported bounty $7,000 to $70,000 (20 to 200 million pesos); reports vary.",
   "sources": [
    "cbs",
    "nbc",
    "rpp",
    "buzz"
   ]
  },
  {
   "id": "D_move",
   "type": "established",
   "nature": "fact",
   "text": "Because of the threats she was moved from the Turbo / Uraba area to El Dorado International Airport in Bogota, away from the gang's stronghold. Narration: 'So the police moved her to Bogota's airport.'",
   "sources": [
    "cbs",
    "npr",
    "wtkr",
    "ap_fox",
    "global",
    "espect2",
    "heraldo"
   ]
  },
  {
   "id": "D_guards",
   "type": "established",
   "nature": "fact",
   "text": "At El Dorado she works with her usual handler plus extra officers as an escort; AP: after her shift she is driven to her kennel in a van with tinted windows, usually with two armed guards. Narration: 'With her own bodyguards.'",
   "sources": [
    "cbs",
    "wtkr",
    "npr",
    "ap_fox",
    "ap_arab",
    "blu"
   ]
  },
  {
   "id": "D_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (practical, for the viewer who flies): do not carry items across a border for anyone else, you are responsible for what you carry (UK FCDO/NCA Travel Aware; Smartraveller); pack your own bags and do not use bags that are not yours (Smartraveller; PNG Customs); an offer of money or a free trip to carry something is a warning sign (Travel Aware). Rows: 'CARRY NOTHING FOR ANYONE', 'PACK YOUR OWN BAG', 'PAID TO CARRY? WALK AWAY'.",
   "sources": [
    "fcdo",
    "smart",
    "pngc"
   ]
  },
  {
   "id": "D_boss",
   "type": "established",
   "nature": "fact",
   "text": "The Gulf Clan's leader at the time, Dairo Antonio Usuga ('Otoniel'), was captured on 23 October 2021 in a rural part of Uraba (Necocli, Antioquia) in Operation Osiris. Narration: 'Their boss was caught in 2021.'",
   "sources": [
    "aj_cap",
    "reu_cap",
    "sent_yh"
   ]
  },
  {
   "id": "D_sentence",
   "type": "established",
   "nature": "fact",
   "text": "Extradited to the United States in May 2022, he pleaded guilty in January 2023 and on 8 August 2023 a federal judge in Brooklyn sentenced him to 45 years. Narration: 'She got bodyguards. He got 45 years.'",
   "sources": [
    "sent_yh",
    "sent_rcn",
    "sent_cambio"
   ]
  }
 ],
