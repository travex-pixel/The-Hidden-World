 "claims": [
  {
   "id": "T_hook",
   "type": "established",
   "nature": "fact",
   "text": "A smoking Nissan Pathfinder SUV, left running with its hazard lights on in Times Square on Saturday 1 May 2010, led police to Faisal Shahzad: its VIN traced the vehicle to its seller and so to him, and he was arrested at JFK airport about 53 hours after the SUV was found. On screen the vehicle is a generic dark SUV with no plate, badge or logo; the make is never said.",
   "sources": [
    "wnyc_arrest",
    "wbur_arrest",
    "wbur_53",
    "npr_charged"
   ]
  },
  {
   "id": "T_smoke",
   "type": "established",
   "nature": "fact",
   "text": "The SUV was parked on West 45th Street just west of Broadway, in a no-standing zone, with its emergency flashers on and the engine running; a small amount of smoke was coming from it (card: 'Saturday 1 May 2010 · evening').",
   "sources": [
    "cbs_vendor",
    "nbcny_vendors",
    "nbcct_hero"
   ]
  },
  {
   "id": "T_vendors",
   "type": "established",
   "nature": "fact",
   "text": "Two T-shirt street vendors, both military veterans (Lance Orton, Navy; Duane Jackson, Army; NOT named on screen), noticed the smoke and alerted a mounted police officer; police cleared the area and the NYPD bomb squad, with a robot, examined the SUV.",
   "sources": [
    "cbs_vendor",
    "nbcny_vendors",
    "legion_vendors",
    "nbcct_hero"
   ]
  },
  {
   "id": "T_failed",
   "type": "established",
   "nature": "fact",
   "text": "The device failed to detonate (the narration: 'The device never went off'); police described it as crude and amateurish.",
   "sources": [
    "mpr_taliban",
    "timeslive",
    "doj_plea",
    "fbi_sentence"
   ]
  },
  {
   "id": "T_contents",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY: police said the SUV held three propane tanks, two gasoline containers, fireworks, alarm clocks and wires; fertilizer found in a locker was not of an explosive grade. Nothing of the device is drawn.",
   "sources": [
    "wt_video",
    "spokesman_video",
    "mpr_taliban"
   ]
  },
  {
   "id": "T_officials",
   "type": "established",
   "nature": "fact",
   "text": "Officials said the device could have been very deadly: Mayor Bloomberg spoke of avoiding 'what could have been a very deadly event' and Commissioner Kelly said it 'would have caused a significant fireball'. Narration: 'Officials said it could have been very deadly.'",
   "sources": [
    "tribune_pk",
    "aljazeera_leads",
    "voa_globalsecurity",
    "wt_video"
   ]
  },
  {
   "id": "T_vin_dash",
   "type": "established",
   "nature": "fact",
   "text": "The vehicle identification number had been removed from the SUV's dashboard.",
   "sources": [
    "wnyc_arrest",
    "wbur_arrest",
    "salon_ap_vin",
    "vindy_ap"
   ]
  },
  {
   "id": "T_vin_engine",
   "type": "established",
   "nature": "fact",
   "text": "Investigators found the VIN stamped on the engine block (some reports: the engine and the axle) and used it to identify the registered owner; the NYPD's chief spokesman called the find 'pivotal'. The number itself is never shown (masked characters).",
   "sources": [
    "wnyc_arrest",
    "wbur_arrest",
    "computerworld",
    "medill_nyt"
   ]
  },
  {
   "id": "T_craigslist",
   "type": "established",
   "nature": "fact",
   "text": "The registered owner (not a suspect; not named on screen) had sold the Pathfinder about three weeks earlier for cash, after advertising it online including on Craigslist, with no paperwork; the seller described and identified the buyer. Reported prices differ, so no amount is said.",
   "sources": [
    "cnn_tr_0504",
    "medill_nyt",
    "salon_ap_vin",
    "vindy_ap",
    "volokh_reuters"
   ]
  },
  {
   "id": "T_phone",
   "type": "established",
   "nature": "fact",
   "text": "The buyer's phone number was a prepaid cellphone; the FBI obtained the vendor's records and linked the phone to Shahzad (calls to Pakistan and to a fireworks store; a match against entry records).",
   "sources": [
    "volokh_reuters",
    "computerworld",
    "courthouse",
    "abc7_charges"
   ]
  },
  {
   "id": "T_shahzad",
   "type": "established",
   "nature": "fact",
   "text": "Faisal Shahzad, then 30, a naturalized U.S. citizen born in Pakistan and living in Connecticut.",
   "sources": [
    "wbur_arrest",
    "npr_charged",
    "doj_plea",
    "fbi_sentence"
   ]
  },
  {
   "id": "T_nofly",
   "type": "established",
   "nature": "fact",
   "text": "Shahzad was added to the no-fly list on 3 May 2010 after he was identified; the airline had not yet updated its copy of the list, so he was able to buy a ticket and board; a Customs and Border Protection check of the final passenger manifest caught his name. Airlines were afterwards required to check list updates within two hours.",
   "sources": [
    "aba_nofly",
    "cbs_nofly",
    "aljazeera_nofly",
    "cbs_emirates"
   ]
  },
  {
   "id": "T_ticket",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY: he reserved the flight on the way to the airport and paid for the ticket in cash.",
   "sources": [
    "fox_ticket",
    "salon_ap_ticket"
   ]
  },
  {
   "id": "T_boarded",
   "type": "established",
   "nature": "fact",
   "text": "On the night of Monday 3 May 2010 he boarded an Emirates flight to Dubai at JFK airport in New York (the airline is not named on screen; the aircraft and cabin are generic).",
   "sources": [
    "fox_passengers",
    "cbs_audio",
    "nycaviation",
    "wbur_arrest"
   ]
  },
  {
   "id": "T_recalled",
   "type": "established",
   "nature": "fact",
   "text": "The plane had left the gate and was taxiing (passengers: for about five minutes) when air traffic control ordered it back to the gate; Customs and Border Protection officers removed Shahzad from the plane and he was arrested, identified at about 11:45 p.m. Narration: 'The plane had left the gate. It was called back.' / 'He was taken off the plane.'",
   "sources": [
    "fox_passengers",
    "cbs_audio",
    "nycaviation",
    "cbs_nofly",
    "salon_ap_vin"
   ]
  },
  {
   "id": "T_53",
   "type": "established",
   "nature": "fact",
   "text": "The arrest came about 53 hours after the SUV was discovered in Times Square (card: 'about 53 hours after the smoke').",
   "sources": [
    "wbur_53",
    "mpr_53",
    "npr_charged"
   ]
  },
  {
   "id": "T_plea",
   "type": "established",
   "nature": "fact",
   "text": "On 21 June 2010 Shahzad pleaded guilty in Manhattan federal court, before Judge Miriam Goldman Cedarbaum, to all ten counts of the indictment; there was no plea agreement.",
   "sources": [
    "doj_plea",
    "npr_plea",
    "fbi_sentence"
   ]
  },
  {
   "id": "T_sentence",
   "type": "established",
   "nature": "fact",
   "text": "On 5 October 2010 he was sentenced to life in prison (a mandatory life term on the charges).",
   "sources": [
    "fbi_sentence",
    "cbs_sentence",
    "nbcny_sentence"
   ]
  }
 ],
