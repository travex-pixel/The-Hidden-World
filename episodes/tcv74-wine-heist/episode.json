 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "About 30,000 bottles were stolen from Marchesi Antinori's facility near Cortona, Tuscany; the company calls it the largest wine theft on record in Italy. Discovered Monday 5 October 2026, made public Friday 9 October. Narration: 'This wine heist took 30,000 bottles.' Headline 'THE 30,000-BOTTLE / WINE HEIST'.",
   "sources": [
    "ap_abc",
    "ap_spec",
    "reuters_ctv",
    "unione",
    "ynet"
   ]
  },
  {
   "id": "K_forklifts",
   "type": "established",
   "nature": "fact",
   "text": "The thieves used the company's own forklifts to load the bottles onto their trucks (CEO Renzo Cotarella). Narration: 'Loaded with the winery's own forklifts.'",
   "sources": [
    "ap_abc",
    "ynet",
    "ap_spec"
   ]
  },
  {
   "id": "K_alarms",
   "type": "established",
   "nature": "fact",
   "text": "The thieves disabled the alarm system and surveillance cameras, then entered with two large trucks. Narration: 'They switched off the alarms and cameras.' / 'Then two trucks left ...'",
   "sources": [
    "ap_abc",
    "ynet",
    "reuters_ctv"
   ]
  },
  {
   "id": "K_value",
   "type": "established",
   "nature": "fact",
   "text": "The stolen wine was valued at about EUR 5 million (about US$5.8-6 million). Narration: 'five million euros of wine'. Counter 'EUR 5,000,000'.",
   "sources": [
    "ap_abc",
    "reuters_ctv",
    "reuters_int",
    "unione",
    "ewn"
   ]
  },
  {
   "id": "K_solaia",
   "type": "established",
   "nature": "fact",
   "text": "The haul included about 8,000-10,000 bottles of Solaia (2023 vintage), a wine made at only about 60,000-70,000 bottles a year, plus Tignanello and Guado al Tasso. Label 'INCL. 8,000-10,000 SOLAIA'.",
   "sources": [
    "ap_abc",
    "ap_spec",
    "reuters_ctv",
    "global"
   ]
  },
  {
   "id": "K_atrio",
   "type": "established",
   "nature": "fact",
   "text": "October 2021, the Atrio hotel and two-Michelin-star restaurant in Caceres, Spain: a couple stayed as guests (the woman checked in with a fake Swiss passport), dined and toured the cellar. Narration: 'In Spain, a couple checked into a top hotel.' (rehook 'But that was not the smoothest one.' is editorial).",
   "sources": [
    "cnn_arrest",
    "guardian",
    "ati",
    "decanter_atrio"
   ]
  },
  {
   "id": "K_room",
   "type": "established",
   "nature": "fact",
   "text": "In the night the woman ordered room service; the lone clerk left the desk and the man took the key to the cellar. Narration: 'Late that night, she ordered room service.'",
   "sources": [
    "ati",
    "cnn_arrest",
    "cbs_atrio"
   ]
  },
  {
   "id": "K_45",
   "type": "established",
   "nature": "fact",
   "text": "45 bottles were stolen (first valued at about EUR 1.6 million; a court expert later put it at about EUR 750,000). Narration: 'He took 45 bottles.'",
   "sources": [
    "cnn_atrio",
    "guardian",
    "cbs_atrio",
    "decanter_atrio"
   ]
  },
  {
   "id": "K_1806",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: the bottles included an 1806 Chateau d'Yquem. Narration: 'One from 1806.'",
   "sources": [
    "weinplus",
    "cnn_arrest",
    "decanter_atrio"
   ]
  },
  {
   "id": "K_jailed",
   "type": "established",
   "nature": "fact",
   "text": "The pair were arrested in July 2022 at the Montenegro-Croatia border and sentenced in March 2023 to 4.5 and 4 years; the wine has not been recovered. Label only.",
   "sources": [
    "cnn_atrio",
    "guardian",
    "cbs_atrio",
    "decanter_atrio"
   ]
  },
  {
   "id": "K_planners",
   "type": "established",
   "nature": "fact",
   "text": "19 November 2025, L'Auberge Provencale, White Post, Virginia: two people posing as event planners (for a supposed client) asked for a tour of the wine cellar. Narration: 'Then Virginia. Fake event planners asked for a cellar tour.'",
   "sources": [
    "nvm_va",
    "db_va",
    "wt_va",
    "ind_va"
   ]
  },
  {
   "id": "K_swap",
   "type": "established",
   "nature": "fact",
   "text": "They replaced the real bottles with decoy/counterfeit bottles to cover the theft. Narration: 'They left fake bottles in the rack.'",
   "sources": [
    "db_va",
    "wt_va",
    "nvm_va"
   ]
  },
  {
   "id": "K_42k",
   "type": "established",
   "nature": "fact",
   "text": "Six bottles (Domaine de la Romanee-Conti wines) worth about $42,000 were taken. Narration: 'Worth about $42,000.' Label 'SIX BOTTLES · ABOUT $42,000'",
   "sources": [
    "ws_va",
    "wt_va",
    "db_va"
   ]
  },
  {
   "id": "K_caught",
   "type": "established",
   "nature": "fact",
   "text": "Staff stopped one suspect, Natali Ray, who later pleaded guilty (12 months in jail); the alleged accomplice remains a fugitive. Narration: 'Staff caught one. The other got away.' Label 'SHE PLEADED GUILTY · 12 MONTHS'.",
   "sources": [
    "ws_va",
    "ind_va",
    "nvd_va",
    "db_va2"
   ]
  },
  {
   "id": "K_missing",
   "type": "established",
   "nature": "fact",
   "text": "As of 18 October 2026 no arrests or recovered bottles were reported in the Antinori theft; police and Carabinieri are investigating. Narration: 'Antinori's bottles? Still missing.'",
   "sources": [
    "reuters_ctv",
    "ap_abc",
    "unione"
   ]
  },
  {
   "id": "K_part2",
   "type": "established",
   "nature": "fact",
   "text": "PART 2 TEASE (end card): August 2017, thieves came through the Paris catacombs into a private cellar near the Luxembourg Gardens and stole about 300 bottles (about EUR 250,000). End card 'PART 2: A TUNNEL INTO A PARIS CELLAR'.",
   "sources": [
    "local_paris",
    "decanter_paris",
    "fox_paris"
   ]
  }
 ],
