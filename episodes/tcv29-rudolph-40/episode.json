 "claims": [
  {
   "id": "R_hid",
   "type": "established",
   "nature": "fact",
   "text": "Eric Rudolph, the Centennial Olympic Park bomber, was a fugitive from 1998 (charged; FBI Ten Most Wanted from 5 May 1998) until his arrest on 31 May 2003, about five years, hiding in the mountains of western North Carolina.",
   "sources": [
    "cbs_2003",
    "doj_2003",
    "ap_suffolk",
    "wiki_rudolph"
   ]
  },
  {
   "id": "R_dumpster",
   "type": "established",
   "nature": "fact",
   "text": "He was arrested early on 31 May 2003 behind a grocery store (a Save-A-Lot) in Murphy, North Carolina, after an officer saw him going through the store's dumpster / trash bin for food (AP: 'scavenging for food behind a grocery store'; WSB-TV: 'rummaging for food in a dumpster behind a grocery store'; ABA Journal: 'foraging in the dumpster'). The drawn dumpster is generic, with no store name or logo.",
   "sources": [
    "ap_suffolk",
    "wsb",
    "aba",
    "yahoo_fbi",
    "abc_2003"
   ]
  },
  {
   "id": "R_toll",
   "type": "established",
   "nature": "fact",
   "text": "The pipe bomb that exploded in Centennial Olympic Park, Atlanta, early on 27 July 1996 during the Summer Olympics killed one woman and injured more than 100 people (111 per History.com and other accounts); a second man died of a heart attack. Victims are not named in narration and are never shown.",
   "sources": [
    "history_park",
    "anf_2026",
    "wiki_park"
   ]
  },
  {
   "id": "R_more",
   "type": "established",
   "nature": "fact",
   "text": "Rudolph also bombed an abortion clinic in Sandy Springs, Georgia (January 1997), a lesbian nightclub in Atlanta (February 1997) and an abortion clinic in Birmingham, Alabama (January 1998), where an off-duty police officer was killed. Card only beyond 'three more bombings'.",
   "sources": [
    "wsb",
    "doj_1998",
    "history_plea",
    "doj_2005"
   ]
  },
  {
   "id": "R_list",
   "type": "established",
   "nature": "fact",
   "text": "The FBI added Rudolph to its Ten Most Wanted Fugitives list on 5 May 1998 and offered a reward of up to $1 million.",
   "sources": [
    "doj_2003",
    "cbs_2003",
    "doj_1998",
    "wiki_rudolph"
   ]
  },
  {
   "id": "R_hunt",
   "type": "established",
   "nature": "fact",
   "text": "More than 200 federal and state agents searched the Nantahala mountains of western North Carolina in 1998 (CNN; AccessWDUN: more than 200 searchers at one time); the search used helicopters with infrared scopes and logs rigged with motion detectors (AP). The FBI later scaled the search back (CBS).",
   "sources": [
    "cnn_2002",
    "accesswdun_2002",
    "ap_suffolk",
    "cbs_scaleback"
   ]
  },
  {
   "id": "R_rookie",
   "type": "established",
   "nature": "fact",
   "text": "The arresting officer was Jeff Postell, a 21-year-old Murphy police rookie (on the force less than a year) on routine patrol; he drove behind the store at about 3:30-4 a.m. (accounts differ) and thought he had a burglar or prowler. He is not named on screen and is drawn as a generic officer.",
   "sources": [
    "ap_suffolk",
    "cbs_2003",
    "cpp_2013",
    "aba",
    "wiki_rudolph"
   ]
  },
  {
   "id": "R_name",
   "type": "established",
   "nature": "fact",
   "text": "The man first gave a false name (reported as 'Jerry Wilson'); officers at the jail recognised him and he admitted he was Eric Robert Rudolph; the FBI confirmed his identity by fingerprints.",
   "sources": [
    "ap_suffolk",
    "yahoo_fbi",
    "cnn_0531",
    "doj_2003"
   ]
  },
  {
   "id": "R_plea",
   "type": "established",
   "nature": "fact",
   "text": "In April 2005 Rudolph pleaded guilty to the Atlanta and Birmingham bombings under a deal that spared him the death penalty; he was sentenced in July and August 2005 to life in prison without parole (multiple consecutive life terms) and is held at ADX Florence, Colorado.",
   "sources": [
    "history_plea",
    "nbc_plea",
    "aljazeera",
    "doj_2005",
    "nbc_sentence",
    "jurist"
   ]
  }
 ],
