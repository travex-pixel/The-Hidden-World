    {
     "claim": "B_1975",
     "type": "established",
     "claim_text": "In the early hours of 16 August 1975, Utah Highway Patrol Sgt Bob Hayward saw a Volkswagen Beetle driving with its lights off in the Granger area of Salt Lake County; it fled and he pursued it until it pulled into a gas station. The trooper is not named on screen.",
     "urls": [
      "https://www.deseret.com/2000/8/20/19524726/officer-recalls-bundy-s-75-capture",
      "https://killerinthearchives.blog/the-first-arrest-1975/",
      "https://news.yahoo.com/ted-bundy-apos-world-apos-100000543.html",
      "https://www.ldsliving.com/ted-bundy-and-2-other-notorious-criminals-taken-down-by-latter-day-saints/s/87484"
     ]
    },
    {
     "claim": "B_items",
     "type": "established",
     "claim_text": "The Beetle's passenger seat had been removed; officers found items including a crowbar, a ski mask and handcuffs (also an ice pick, a pantyhose mask and garbage bags). Bundy was arrested - his first arrest - and was charged with possession of burglary tools days later. The items are named on a typed card only and never drawn.",
     "urls": [
      "https://www.deseret.com/2000/8/20/19524726/officer-recalls-bundy-s-75-capture",
      "https://crimelibrary.org/serial_killers/notorious/bundy/8.html",
      "https://killerinthearchives.blog/the-first-arrest-1975/",
      "https://news.yahoo.com/ted-bundy-apos-world-apos-100000543.html"
     ]
    }
   ],
