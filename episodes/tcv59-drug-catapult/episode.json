 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "In January 2011 smugglers on the Mexican side used a catapult to launch packages of marijuana over the border fence into Arizona near Naco. Narration: 'Smugglers catapulted weed into America.' (NPR: 'Drug smugglers get medieval'.)",
   "sources": [
    "nbc",
    "cbs",
    "arab",
    "csm",
    "popsci",
    "npr",
    "politifact"
   ]
  },
  {
   "id": "K_year",
   "type": "established",
   "nature": "fact",
   "text": "The catapult was used and seized in January 2011 (Friday evening, 21 January 2011; reported 26-28 January 2011). Narration: 'In 2011. Not the Middle Ages.'",
   "sources": [
    "nbc",
    "csm",
    "register",
    "politifact"
   ]
  },
  {
   "id": "K_cams",
   "type": "established",
   "nature": "fact",
   "text": "National Guard troops operating a remote video surveillance system at the Naco Border Patrol Station saw several people preparing a catapult and launching packages over the international border fence. Narration: 'But National Guard troops were watching on camera.'",
   "sources": [
    "nbc",
    "cbs",
    "csm",
    "popsci"
   ]
  },
  {
   "id": "K_launch",
   "type": "established",
   "nature": "fact",
   "text": "The people seen on the video loaded the device and launched packages over the fence (night-vision footage). Narration: 'Men flung bundles right over the fence.'",
   "sources": [
    "nbc",
    "cbs",
    "csm",
    "npr"
   ]
  },
  {
   "id": "K_fourlb",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: a Mexican army officer said the catapult could launch about 4.4 lb (2 kg) of marijuana at a time. Narration: 'Each shot? Over four pounds.'",
   "sources": [
    "cbs",
    "star",
    "nbc",
    "arab"
   ]
  },
  {
   "id": "K_raid",
   "type": "established",
   "nature": "fact",
   "text": "Border Patrol alerted Mexican authorities; Mexican soldiers moved in and the smugglers fled. Narration: 'Mexican soldiers moved in. The smugglers ran.'",
   "sources": [
    "nbc",
    "cbs",
    "arab",
    "csm"
   ]
  },
  {
   "id": "K_left",
   "type": "established",
   "nature": "fact",
   "text": "The smugglers left the catapult behind: about three yards (9-10 ft) tall, elastic-powered, on a flatbed trailer towed by an SUV, about 20 yards from the border. Narration: 'And left their catapult behind.' Label 'LEFT BEHIND: A 3-YARD CATAPULT'.",
   "sources": [
    "cbs",
    "nbc",
    "arab",
    "star",
    "npr"
   ]
  },
  {
   "id": "K_wild",
   "type": "established",
   "nature": "fact",
   "text": "Editorial bridge: smugglers at the same border later used other devices (see K_cannon); a Border Patrol spokesman said in 2012: 'We've seen catapults, but nothing like this.' Narration: 'But that was not their wildest idea.'",
   "sources": [
    "ktar",
    "popsci_can",
    "officer_can"
   ]
  },
  {
   "id": "K_cannon",
   "type": "established",
   "nature": "fact",
   "text": "In December 2012 Border Patrol agents near San Luis, Arizona (Yuma Sector) found 33 cans of marijuana (about 85 lb) in a field and a CO2 tank by the fence; agents believed a pneumatic (compressed-gas) cannon fired them over the fence; no arrests. Narration: 'Next, a gas cannon firing cans of weed.'",
   "sources": [
    "ktar",
    "popsci_can",
    "officer_can",
    "cpost"
   ]
  },
  {
   "id": "K_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): U.S. Customs and Border Protection counted 228 ultralight incursions along the Mexican border in fiscal 2010, up from 118 the year before (KPBS: 2009 to 2010). Narration: 'Ultralight planes? 228 crossings in one year.'",
   "sources": [
    "bend",
    "officer_ul",
    "kpbs",
    "npr_ul"
   ]
  },
  {
   "id": "K_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (practical, for the viewer): crossing a border: do not carry any items for someone else and be aware of the contents of your bags (Smartraveller); travellers carrying more than $10,000 in currency must report it to CBP (USA.gov; CBP Form 6059B; FinCEN 105). Rows: 'CARRY NOTHING FOR ANYONE', 'KNOW WHAT IS IN YOUR BAGS', 'DECLARE CASH OVER $10,000'.",
   "sources": [
    "smart",
    "smart_d",
    "usagov",
    "cbp6059"
   ]
  },
  {
   "id": "K_outcome",
   "type": "established",
   "nature": "fact",
   "text": "The smugglers fled and were not caught; no arrests were reported. Narration: 'The smugglers got away.'",
   "sources": [
    "nbc",
    "cbs",
    "arab",
    "csm",
    "popsci"
   ]
  },
  {
   "id": "K_seized",
   "type": "established",
   "nature": "fact",
   "text": "Mexican soldiers seized the catapult, an SUV and the marijuana (about 45 lb per NBC, Reuters and CSM; 35 lb per AP/CBS). Narration: 'Only the catapult got caught.' Label 'SEIZED: CATAPULT, SUV, WEED'.",
   "sources": [
    "nbc",
    "cbs",
    "arab",
    "csm",
    "register"
   ]
  }
 ],
