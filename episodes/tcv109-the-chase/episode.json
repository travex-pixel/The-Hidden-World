 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "About 350 kg of cocaine was hidden under a tarpaulin in the hull of a rigid-hulled inflatable boat (RHIB) intercepted off Suffolk; the man at its helm pleaded guilty to being concerned in importing it. Narration: 'A smuggler carried cocaine beneath a boat's tarp.' Headline 'THE TARP / 350 KG UNDER IT'. 'Carried' (not 'packed' or 'hid') because the plea establishes knowing importation, not who covered the load.",
   "sources": [
    "nca_sent",
    "itv",
    "pa",
    "eadt"
   ]
  },
  {
   "id": "K_weight",
   "type": "established",
   "nature": "fact",
   "text": "About 350 kg (350 kilos) of cocaine. Narration: '350 kilos of it.' Callout '350 KG OF COCAINE'. The value (£39m NCA, £37m PA) is not narrated or shown.",
   "sources": [
    "nca_charge",
    "nca_sent",
    "pa",
    "occrp"
   ]
  },
  {
   "id": "K_cutter",
   "type": "established",
   "nature": "fact",
   "text": "24 June 2024, near East Benacre Broads off the Suffolk coast: a Border Force cutter approached the RHIB and it failed to stop. Narration: 'A Border Force cutter closed in.' Label 'OFF BENACRE, SUFFOLK · 24 JUNE 2024'. The cutter is drawn generic (its name is not reported).",
   "sources": [
    "nca_charge",
    "nca_sent",
    "occrp",
    "ypost"
   ]
  },
  {
   "id": "K_swim",
   "type": "established",
   "nature": "fact",
   "text": "His crewmate jumped overboard and swam towards the shore. Narration: 'His crewmate jumped.' Not named.",
   "sources": [
    "nca_sent",
    "itv",
    "pa",
    "lbc",
    "dutch"
   ]
  },
  {
   "id": "K_flee",
   "type": "established",
   "nature": "fact",
   "text": "Knowles restarted the engines and attempted to flee. Narration (the gotcha): 'Then he restarted the engines. And fled.'",
   "sources": [
    "nca_sent",
    "pa",
    "occrp",
    "eadt"
   ]
  },
  {
   "id": "K_aground",
   "type": "established",
   "nature": "fact",
   "text": "After a pursuit, the boat ran aground / was grounded on the beach. Narration: 'He ran the boat up onto a beach.'",
   "sources": [
    "nca_sent",
    "itv",
    "pa",
    "dereham"
   ]
  },
  {
   "id": "K_jump",
   "type": "established",
   "nature": "fact",
   "text": "As officers moved in to arrest him, Knowles jumped overboard (went into the water) and was caught. Narration: 'Then he jumped into the sea.'",
   "sources": [
    "nca_sent",
    "itv",
    "occrp",
    "dereham"
   ]
  },
  {
   "id": "K_person",
   "type": "established",
   "nature": "fact",
   "text": "He is Bruce Knowles, 55 at the time (56 at sentencing), of Dereham, Norfolk; he pleaded guilty and is named by the NCA and widely in the press. Named ON A LABEL ONLY: 'BRUCE KNOWLES, 55 · DEREHAM', sub 'Pleaded guilty · silhouette, not a likeness'. Drawn only as a silhouette.",
   "sources": [
    "eadt",
    "dereham",
    "occrp",
    "pa",
    "itv"
   ]
  },
  {
   "id": "K_tarp",
   "type": "established",
   "nature": "fact",
   "text": "The boat was towed to Lowestoft, where the cocaine was found hidden under a tarpaulin in the hull. Narration: 'At the harbour, officers pulled back the tarp.' (the tarpaulin's colour is not reported: drawn a generic orange).",
   "sources": [
    "nca_sent",
    "itv",
    "suffolknews"
   ]
  },
  {
   "id": "K_lowestoft",
   "type": "established",
   "nature": "fact",
   "text": "Lowestoft harbour (where the RHIB was towed). Label 'LOWESTOFT · JUNE 2024'.",
   "sources": [
    "nca_sent",
    "itv",
    "suffolknews"
   ]
  },
  {
   "id": "K_plea",
   "type": "established",
   "nature": "fact",
   "text": "He pleaded guilty at Ipswich Crown Court (August 2024) to being concerned in the fraudulent evasion of a prohibition on importing Class A drugs. Narration: 'He pleaded guilty.' Label 'IPSWICH CROWN COURT', sub 'Pleaded guilty · Aug 2024'.",
   "sources": [
    "dereham",
    "nca_sent",
    "occrp",
    "gym"
   ]
  },
  {
   "id": "K_years",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter 17 YEARS, label 'AND 3 MONTHS'): he was jailed for 17 years and 3 months at Ipswich Crown Court in May 2025. Narration: '17 years and 3 months.'",
   "sources": [
    "nca_sent",
    "itv",
    "pa",
    "dereham"
   ]
  },
  {
   "id": "K_caught",
   "type": "established",
   "nature": "fact",
   "text": "The crewmate who swam was arrested later that same day by Norfolk and Suffolk police (one report: about eight hours later). Narration: 'Police caught the swimmer that same day.' The town (Wrentham or Beccles: reports differ) is not used.",
   "sources": [
    "nca_sent",
    "dereham",
    "dutch"
   ]
  },
  {
   "id": "K_france",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT (attributed): investigators believe the pair went towards French waters to collect the drugs from a larger ship before heading back to the UK. Card 'INVESTIGATORS BELIEVE / THEY MET A BIGGER SHIP / OFF FRANCE'.",
   "sources": [
    "nca_sent",
    "occrp",
    "eadt"
   ]
  },
  {
   "id": "K_fifteen",
   "type": "established",
   "nature": "fact",
   "text": "The crewmate was jailed for 15 years (Ipswich Crown Court, May 2025). Narration (callback): 'The swimmer got fifteen years.'",
   "sources": [
    "nca_sent",
    "itv",
    "pa",
    "dereham"
   ]
  }
 ],
