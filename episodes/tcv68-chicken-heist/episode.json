 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "allegation",
   "text": "On 15 September 2026 in Memphis, 13 people were arrested after the Memphis Safe Task Force found a group unloading pallets of stolen chicken from an 18-wheeler behind an Economy Inn (WMC and WREG: 13; CCJ counts 12 charged). Narration: '13 arrested in a chicken heist.' Headline 'THE $250,000 / CHICKEN HEIST'. All are accused only.",
   "sources": [
    "wmc",
    "wmc2",
    "wreg",
    "pm",
    "ccj"
   ]
  },
  {
   "id": "K_value",
   "type": "established",
   "nature": "allegation",
   "text": "The chicken was valued at $250,000 (the task force's figure, reported by WMC/Gray and WREG); FreightWaves reports the police affidavit and MPD put the shipment at about $110,000. Narration: 'The load? $250,000, officials say.' Label 'VALUED AT $250,000 BY THE TASK FORCE / Police affidavit: about $110,000'.",
   "sources": [
    "wmc",
    "wreg",
    "fw",
    "mw"
   ]
  },
  {
   "id": "K_warrant",
   "type": "established",
   "nature": "fact",
   "text": "Officers were at the motel to serve an unrelated aggravated-robbery warrant on one man when they found him and 12 others unloading the chicken. Narration: 'Police were only there for a different warrant.'",
   "sources": [
    "wmc",
    "wmc2",
    "wreg",
    "pm",
    "fw"
   ]
  },
  {
   "id": "K_debt",
   "type": "established",
   "nature": "allegation",
   "text": "Police say the driver told investigators he had agreed to trade his shipment to pay off a drug debt owed to one of the men arrested (affidavit). Narration: 'And police say the driver was paying off a drug debt.' Label 'ACCUSED · NOT CONVICTED / Driver's account, per a police affidavit'.",
   "sources": [
    "wmc",
    "wreg",
    "fw",
    "pm"
   ]
  },
  {
   "id": "K_worse",
   "type": "established",
   "nature": "editorial",
   "text": "Editorial bridge to item 2. Narration: 'It gets worse.'",
   "sources": [
    "nbc_eggs",
    "abc_eggs"
   ]
  },
  {
   "id": "K_eggs",
   "type": "established",
   "nature": "fact",
   "text": "On 1 February 2025 about 100,000 eggs (about $40,000) were stolen from a distribution trailer outside Pete & Gerry's Organics in Greencastle, Franklin County, Pennsylvania, during the bird-flu egg shortage; Pennsylvania State Police investigated; no arrests reported. Narration: 'It gets worse. 100,000 eggs, stolen in Pennsylvania.' Label 'GREENCASTLE, PENNSYLVANIA · FEB 2025 / About $40,000 · during the egg shortage · no arrests'.",
   "sources": [
    "nbc_eggs",
    "abc_eggs",
    "cbc_eggs",
    "scripps_eggs"
   ]
  },
  {
   "id": "K_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (practical, for the viewer): before buying meat from a door-to-door or truck seller: the package must carry the USDA inspection mark / plant number (USDA FSIS; Arkansas AG); do not buy from a truck or car trunk that is not refrigerated (Arkansas AG; North Dakota); get a receipt with the seller's name and address (Arizona; North Dakota). Rows 'NO USDA INSPECTION MARK', 'NOT KEPT COLD? WALK AWAY', 'NO RECEIPT? NO DEAL'.",
   "sources": [
    "fsis",
    "ar_ag",
    "az",
    "nd"
   ]
  },
  {
   "id": "K_wild",
   "type": "established",
   "nature": "editorial",
   "text": "Editorial bridge to item 3. Narration: 'But the wildest one? A whole truck of KitKats.'",
   "sources": [
    "swiss",
    "gulf",
    "walb",
    "local",
    "foxb"
   ]
  },
  {
   "id": "K_kitkat",
   "type": "established",
   "nature": "fact",
   "text": "Nestle said a truck carrying over 12 tonnes (413,793 bars) of its new KitKat range was stolen in transit from central Italy to Poland (reported 28-29 March 2026). Narration: 'Over twelve tonnes, gone between Italy and Poland.' Label 'CENTRAL ITALY TO POLAND · MARCH 2026'.",
   "sources": [
    "swiss",
    "gulf",
    "walb",
    "local",
    "foxb"
   ]
  },
  {
   "id": "K_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): 413,793 bars (Nestle). Narration: 'That is over 413,000 chocolate bars.' Counter '413,793 / KITKAT BARS STOLEN'.",
   "sources": [
    "swiss",
    "gulf",
    "walb",
    "local",
    "foxb"
   ]
  },
  {
   "id": "K_trace",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: Nestle said each bar carries a batch code that can be scanned to check whether it came from the stolen load. Card 'EVERY BAR HAS A BATCH CODE / SCAN IT TO CHECK IF STOLEN'.",
   "sources": [
    "swiss",
    "gulf",
    "walb",
    "local"
   ]
  },
  {
   "id": "K_share",
   "type": "established",
   "nature": "editorial",
   "text": "Share prompt (editorial). Narration: 'Send this to the mate who always orders wings.'",
   "sources": [
    "wmc",
    "wmc2",
    "wreg",
    "pm"
   ]
  },
  {
   "id": "K_outcome",
   "type": "established",
   "nature": "allegation",
   "text": "All 13 people at the Memphis scene were arrested; charges include theft of property $60,000-$250,000; no plea, trial or conviction reported as of 17 October 2026. Narration: 'Memphis? All 13 arrested.' Label 'AS OF OCT 2026 · CHARGED, NOT CONVICTED'.",
   "sources": [
    "wmc",
    "wmc2",
    "wreg",
    "pm",
    "fw"
   ]
  },
  {
   "id": "K_missing",
   "type": "established",
   "nature": "fact",
   "text": "Nestle said the truck and its load had not been found; no recovery or arrest has been reported as of 17 October 2026. Narration (last line): 'The KitKats? Still missing.'",
