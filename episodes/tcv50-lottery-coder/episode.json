 "claims": [
  {
   "id": "L_hook",
   "type": "established",
   "nature": "fact",
   "text": "Eddie Tipton was the information security director of the Multi-State Lottery Association (MUSL), the Iowa-based association that runs multi-state lottery games; he admitted rigging lottery draws (guilty plea, June 2017). Narration: 'The lottery's own security boss rigged it.' Headline: 'LOTTERY SECURITY BOSS / RIGGED THE JACKPOTS'.",
   "sources": [
    "ap_cnn",
    "ap_kshb",
    "kcrg",
    "fox_25"
   ]
  },
  {
   "id": "L_code",
   "type": "established",
   "nature": "fact",
   "text": "Investigators said code he added to the random number generator software let it work normally except on three days of the year, when it produced predictable numbers (for Wednesday or Saturday draws after 8 p.m.); he admitted rigging computer code to produce winning numbers. Narration: 'His secret code made 3 days a year predictable.'",
   "sources": [
    "ap_ksl",
    "ap_inq",
    "sophos16",
    "ap_cnn"
   ]
  },
  {
   "id": "L_crew",
   "type": "established",
   "nature": "fact",
   "text": "He conspired with his brother Tommy Tipton, his friend Robert Rhodes and others to buy and claim winning tickets. Narration: 'His brother and a friend claimed wins in five states.'",
   "sources": [
    "fox_scope",
    "kcrg",
    "ap_cnn"
   ]
  },
  {
   "id": "L_states",
   "type": "established",
   "nature": "fact",
   "text": "The rigged prizes were in five states (Colorado, Wisconsin, Oklahoma, Kansas and Iowa) between 2005 and 2011; he agreed to about $2.2 million in restitution to Colorado, Oklahoma, Wisconsin and Kansas.",
   "sources": [
    "fox_scope",
    "ap_cnn",
    "ap_kshb",
    "ap_ksl"
   ]
  },
  {
   "id": "L_tommy",
   "type": "established",
   "nature": "fact",
   "text": "Tommy Tipton was a justice of the peace in Texas (AP: 'a former Texas judge'); he pleaded guilty in Iowa in 2017 to conspiracy to commit theft. Narration: 'The brother was a Texas judge.' The card says 'JUSTICE OF THE PEACE'.",
   "sources": [
    "ap_cnn",
    "fox_scope",
    "kcrg"
   ]
  },
  {
   "id": "L_ticket",
   "type": "established",
   "nature": "fact",
   "text": "The Hot Lotto ticket was bought on 23 Dec 2010 at a QuikTrip in Des Moines, Iowa, for the 29 Dec 2010 draw; the advertised jackpot was $16.5 million (cash value about $10.75 million). AP and other outlets also used '$14.3 million' (recorded as a disagreement). Narration: 'Then one Iowa ticket hit a $16.5 million jackpot.'",
   "sources": [
    "casino",
    "rd",
    "wiki",
    "fox_myst",
    "cnn11"
   ]
  },
  {
   "id": "L_unclaimed",
   "type": "established",
   "nature": "fact",
   "text": "No one came forward to claim the jackpot for most of the one-year claim period. Narration: 'But nobody claimed it.'",
   "sources": [
    "fox_myst",
    "cnn11",
    "wiki"
   ]
  },
  {
   "id": "L_belize",
   "type": "established",
   "nature": "fact",
   "text": "In late December 2011, less than two hours before the one-year deadline, a New York lawyer filed a claim on behalf of a trust tied to a Belize company (Hexham Investments Trust); earlier a Quebec lawyer had called. Narration: 'Lawyers tried claiming it for a trust in Belize.'",
   "sources": [
    "fox_myst",
    "wiki",
    "rd",
    "cnn11"
   ]
  },
  {
   "id": "L_refused",
   "type": "established",
   "nature": "fact",
   "text": "The Iowa Lottery refused to pay because the trust would not identify who bought the ticket (anonymous claims were not allowed); the claim was withdrawn. Narration: 'The lottery refused. Who bought it?'",
   "sources": [
    "fox_myst",
    "wiki",
    "cnn11"
   ]
  },
  {
   "id": "L_video",
   "type": "established",
   "nature": "fact",
   "text": "The store's surveillance camera recorded the buyer; Iowa officials released the footage in October 2014. Narration: 'A gas station camera filmed the buyer.'",
   "sources": [
    "fox_myst",
    "rd",
    "irishex",
    "artful"
   ]
  },
  {
   "id": "L_voice",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: people who knew him, including an Iowa Lottery co-worker who had worked alongside him for years, recognised the buyer by his voice rather than his appearance, and named Eddie Tipton. Narration: 'Co-workers knew that voice. It was Eddie Tipton.' Card: 'CO-WORKERS KNEW HIS VOICE, / NOT HIS FACE.'",
   "sources": [
    "rd",
    "artful",
    "irishex"
   ]
  },
  {
   "id": "L_camera",
   "type": "established",
   "nature": "alleged",
   "text": "ALLEGED by prosecutors (2015 trial; not narrated, card only, attributed): he set the draw-room camera to record one second per minute and used a USB drive to install software on the draw computer.",
   "sources": [
    "hackread",
    "sophos16",
    "bitdef"
   ]
  },
  {
   "id": "L_odds",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): the odds of winning the Powerball jackpot (grand prize) are 1 in 292,201,338 (Powerball prize chart; also stated by CNBC). Narration: 'Powerball jackpot odds? 1 in 292 million.'",
   "sources": [
    "pb_chart",
    "ia_pb",
    "cnbc"
   ]
  },
  {
   "id": "L_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (FTC consumer advice): never pay a fee to collect a prize (anyone who asks is a scammer); if you did not enter, you did not win; no one legitimate asks for payment by gift card, wire transfer or crypto. Rows: 'NEVER PAY TO GET A PRIZE', 'NO ENTRY? THEN NO WIN', 'NO GIFT CARDS OR WIRES'.",
   "sources": [
    "ftc_prize",
    "sj_da"
   ]
  },
  {
   "id": "L_plea",
   "type": "established",
   "nature": "fact",
   "text": "He was convicted by a jury in July 2015 (later reversed by the Iowa Supreme Court in June 2017 on statute-of-limitations grounds); in June 2017 he pleaded guilty to ongoing criminal conduct under a plea deal.",
   "sources": [
    "ap_cnn",
    "kcrg",
    "gazette17",
    "fox_25"
   ]
  },
  {
   "id": "L_sentence",
   "type": "established",
   "nature": "fact",
   "text": "In August 2017 an Iowa judge, mentioning his greed, gave him the maximum: 25 years (an indeterminate Iowa term, 'up to 25 years'), concurrent with up to 5 1/2 years in Wisconsin. He was paroled in July 2022 (not narrated). Narration: 'The judge cited greed, and gave him 25 years.'",
   "sources": [
    "ap_cnn",
    "ap_kshb",
    "fox_25",
    "ap_parole"
   ]
  }
 ],
