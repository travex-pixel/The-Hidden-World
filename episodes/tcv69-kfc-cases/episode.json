 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "In February 2018 KFC's UK restaurants ran out of chicken after a switch of delivery contract to DHL. Narration: 'KFC ran out of chicken.' Headline 'KFC RAN OUT OF CHICKEN / SO PEOPLE CALLED POLICE'.",
   "sources": [
    "reuters",
    "ap",
    "fortune",
    "arab",
    "cnbc",
    "pa"
   ]
  },
  {
   "id": "K_called",
   "type": "established",
   "nature": "fact",
   "text": "People contacted the police about the closures: Tower Hamlets police (Metropolitan Police, London) asked people to stop; the Met called them nuisance calls; Greater Manchester Police released audio of a 999 call about a closed branch. Narration: 'So people called the police.' (frame 1 shows a phone calling 999).",
   "sources": [
    "pa",
    "week",
    "ell",
    "bi",
    "npr",
    "newshub999",
    "tribune"
   ]
  },
  {
   "id": "K_shut",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): KFC had about 900 UK restaurants and most of them closed (AP: 'most of its 900 outlets'; Reuters: 'the majority of its 900 outlets'; closed counts quoted at different times: 562 (Fortune), more than 600 (PA), more than 700 (KFC via AFP)). Narration: 'Most of its 900 UK restaurants shut.' Counter '900 / KFC UK RESTAURANTS', label 'MOST OF THEM SHUT · FEB 2018'.",
   "sources": [
    "reuters",
    "ap",
    "fortune",
    "arab",
    "cnbc"
   ]
  },
  {
   "id": "K_tweet",
   "type": "established",
   "nature": "fact",
   "text": "Tower Hamlets police tweeted (20 Feb 2018): 'Please do not contact us about the #KFCCrisis - it is not a police matter if your favourite eatery is not serving the menu that you desire.' (wording as reported by PA, East London Lines, The Week, Business Insider). Narration: 'Police tweeted: not a police matter.' Label: \"'IT IS NOT A POLICE MATTER'\".",
   "sources": [
    "pa",
    "ell",
    "week",
    "bi"
   ]
  },
  {
   "id": "K_fck",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: KFC apologised with full-page ads in The Sun and Metro showing an empty KFC bucket with its letters rearranged to read 'FCK' (agency Mother). Narration: 'KFC's apology? A bucket that spelled FCK.' Card 'KFC'S APOLOGY AD: ITS BUCKET / LETTERS REARRANGED TO \"FCK\"'. The ad is NOT reproduced: our card is plain text.",
   "sources": [
    "cnbc",
    "mweek",
    "newshubad",
    "fortunead"
   ]
  },
  {
   "id": "K_worse",
   "type": "established",
   "nature": "editorial",
   "text": "Editorial bridge to item 2. Narration: 'It gets stranger.'",
   "sources": [
    "abc7",
    "fox2",
    "fox6",
    "wtvr",
    "grio",
    "katu"
   ]
  },
  {
   "id": "K_rat",
   "type": "established",
   "nature": "fact",
   "text": "In June 2015 a California customer posted photos on Facebook of a breaded piece he said was a fried rat served at a KFC; the post was shared more than 100,000 times. Narration: 'A man posted a fried rat.' Label 'CALIFORNIA · JUNE 2015' / 'His claim · shared 100,000+ times'. He is not named and drawn only as a silhouette.",
   "sources": [
    "abc7",
    "fox2",
    "fox6",
    "wtvr",
    "grio",
    "katu"
   ]
  },
  {
   "id": "K_lab",
   "type": "established",
   "nature": "fact",
   "text": "KFC said the customer's attorney gave the piece to an independent lab and that its DNA test showed it was chicken; KFC called the claim a hoax; the customer had said a manager confirmed it was a rat, which KFC disputed. Narration: 'The DNA test? KFC said it was chicken.' Label 'KFC: INDEPENDENT LAB · DNA TEST' / 'Result: chicken, per KFC'.",
   "sources": [
    "abc7",
    "fox2",
    "fox6",
    "wtvr",
    "grio",
    "katu"
   ]
  },
  {
   "id": "K_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (practical, for the viewer): call 999 (UK) / 911 (US) when life is at risk or a crime is happening now; for non-urgent matters call 101 or report online (UK police forces, GOV.UK) or use the local non-emergency number (King County 911, Cal OES). Rows 'LIFE AT RISK? 999 / 911', 'CRIME HAPPENING NOW? SAME', 'NOT URGENT? 101 OR ONLINE'.",
   "sources": [
    "wyp",
    "asp",
    "govuk",
    "kingco",
    "caloes"
   ]
  },
  {
   "id": "K_wild",
   "type": "established",
   "nature": "editorial",
   "text": "Editorial bridge to item 3. Narration: 'The wildest? KFC's secret recipe.'",
   "sources": [
    "nbc",
    "nrn",
    "kfcpr",
    "potato"
   ]
  },
  {
   "id": "K_recipe",
   "type": "established",
   "nature": "fact",
   "text": "In September 2008 KFC moved Colonel Sanders' handwritten Original Recipe from its Louisville headquarters for the first time in 68 years while it upgraded security; security consultant and former New York City police detective Bo Dietl carried it in a locked briefcase handcuffed to his wrist, riding in an armored car (Brink's), with an escort (Louisville Metro Police per KFC's release; off-duty police officers and private guards per AP). Narration: 'It was cuffed to a former cop, in an armored car.' Label 'LOUISVILLE · SEPT 2008'. He is not named; silhouette only.",
   "sources": [
    "nbc",
    "nrn",
    "kfcpr",
    "potato",
    "siw"
   ]
  },
  {
   "id": "K_two",
   "type": "established",
   "nature": "fact",
   "text": "KFC said only two executives know the full recipe of 11 herbs and spices, a third knows the safe's combination, and they are not allowed to travel together on the same plane or in the same car. Label 'ONLY 2 EXECUTIVES KNOW IT' / 'They never travel together, KFC said (2008)'.",
   "sources": [
    "nbc",
    "nrn",
    "potato"
   ]
  },
  {
   "id": "K_share",
   "type": "established",
   "nature": "editorial",
   "text": "Share prompt (editorial). Narration: 'Send this to the mate living on KFC.'",
   "sources": [
    "nbc",
    "nrn",
    "kfcpr",
    "potato"
   ]
  },
  {
   "id": "K_punch",
   "type": "established",
   "nature": "editorial",
   "text": "Punchline juxtaposing item 3 (the recipe was guarded and kept safe; no loss was ever reported) with item 1 (the 2018 chicken shortage). Narration: 'The recipe never went missing.' / 'But the chicken did.' ('missing' is colloquial for the shortage).",
   "sources": [
    "nbc",
    "kfcpr",
    "reuters",
    "ap"
   ]
  }
 ],
