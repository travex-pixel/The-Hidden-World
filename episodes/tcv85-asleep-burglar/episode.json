 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "Monday 12 October 2026, Chillicothe, Ohio: officers answering a reported active burglary found a man asleep in a bed in an upstairs (second-floor) bedroom of a house he had no permission to be in; booked into the Ross County Jail on a burglary charge (ORC 2911.12). Accused only. Narration: 'Police say a burglar fell asleep in bed.' Headline 'A BURGLAR FELL ASLEEP / IN A STRANGER'S BED'.",
   "sources": [
    "sciotopost",
    "heritage"
   ]
  },
  {
   "id": "K_lock",
   "type": "established",
   "nature": "fact",
   "text": "The complainant found the lock mechanism of the inner back door missing; the man told officers the back door was unlocked. Narration: 'The back-door lock? Missing. Upstairs: a stranger's house.'",
   "sources": [
    "sciotopost",
    "heritage"
   ]
  },
  {
   "id": "K_found",
   "type": "established",
   "nature": "fact",
   "text": "The complainant reported an active burglary, met officers at the back door and pointed them upstairs; officers found the man asleep and handcuffed him as he woke; the owner confirmed nobody had permission to be inside or stay and asked for charges. Narration: 'Until the owner's relative walked in and called police.' (the complainant shares the owner's surname; neither is named)",
   "sources": [
    "sciotopost",
    "heritage"
   ]
  },
  {
   "id": "K_stat",
   "type": "established",
   "nature": "fact",
   "text": "COUNTER: 13.0 % of burglary offences in the US were cleared in 2022 (FBI Crime in the United States 2022, table 25; the Council on Criminal Justice gives the same 13 %, down from 23 % in 1964).",
   "sources": [
    "ccj",
    "dpf"
   ]
  },
  {
   "id": "K_fall",
   "type": "established",
   "nature": "fact",
   "text": "Frenchtown Township, Monroe County, Michigan: a man who broke into a house on Heiss Road fell down the basement stairs; the noise woke the homeowners, who called 911 at about 3:15 am. Narration: 'Michigan: a burglar fell down the basement stairs.' / 'It woke the homeowners.' No year is given in the extracts; none is shown.",
   "sources": [
    "wwj",
    "wxyz"
   ]
  },
  {
   "id": "K_hid",
   "type": "established",
   "nature": "fact",
   "text": "Deputies searched the house and found him hiding in the basement; taken into custody without further incident; jailed on a first-degree home-invasion charge; name withheld pending arraignment. Label 'FOUND HIDING IN THE BASEMENT'.",
   "sources": [
    "wwj",
    "wxyz"
   ]
  },
  {
   "id": "K_copper",
   "type": "established",
   "nature": "fact",
   "text": "1 October 2026, Oklahoma County, Oklahoma: a deputy investigating a burglary at a vacant house found a man the sheriff's office says was stripping copper from the appliances and walls; body-camera video released mid-October. Narration: 'And the strangest was on bodycam.' / 'Oklahoma. A suspected copper thief.'",
   "sources": [
    "koco_gray",
    "kfor",
    "foxnews",
    "abc7"
   ]
  },
  {
   "id": "K_day",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: FBI 2024 data count 216,601 residential burglaries by day against 174,053 by night (15,122 unknown): more US home burglaries happen by day than by night.",
   "sources": [
    "safehome",
    "moneygeek"
   ]
  },
  {
   "id": "K_dive",
   "type": "established",
   "nature": "fact",
   "text": "Ordered to surrender, the man dived head-first through a closed window and got away on foot; a patrol-car and drone search did not find him. Narration: 'He dived head-first through a closed window.'",
   "sources": [
    "koco_gray",
    "kfor",
    "foxnews",
    "police1"
   ]
  },
  {
   "id": "K_licence",
   "type": "established",
   "nature": "fact",
   "text": "He left his backpack behind with his driver's licence inside, which identified him; charges of burglary, resisting arrest and obstructing an officer were filed; the sheriff's office joked he 'missed his calling as a Hollywood stuntman'. Accused only; the outlets differ on whether he has since been taken into custody, so the reel says only that the licence named him. Narration: 'And left his backpack. Licence still inside.'",
   "sources": [
    "koco_gray",
    "foxnews",
    "abc7"
   ]
  },
  {
   "id": "K_chad",
   "type": "established",
   "nature": "fact",
   "text": "CALLBACK: the Chillicothe man told officers he was 'just sleeping' (wording as reported, both sources; label) and that an acquaintance called 'Chad' had shown him the house. Narration (attributed as his account): 'His story? Chad showed him the house.'",
   "sources": [
    "sciotopost",
    "heritage"
   ]
  }
 ],
