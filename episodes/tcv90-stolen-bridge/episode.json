 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "North Beaver Township, Lawrence County, Pennsylvania, late September-early October 2011: state police say a 50-foot by 20-foot steel bridge (Covert's Crossing, owned by New Castle Development, in a wooded area near a rail line) was cut apart and hauled away; two New Castle brothers, 24 and 25, were charged with criminal mischief, theft, receiving stolen property and conspiracy. Narration: 'Police say two brothers stole a bridge.' Headline 'THEY STOLE / AN ENTIRE BRIDGE' (names nobody). Charged only: never named, silhouettes.",
   "sources": [
    "cbs",
    "cbs2",
    "cbspit",
    "abc",
    "abc6",
    "upi",
    "time",
    "wpxi",
    "claims",
    "whyy"
   ]
  },
  {
   "id": "K_torch",
   "type": "established",
   "nature": "fact",
   "text": "Investigators said a torch was used to cut the bridge apart; the complaint says the men sold 31,000 lb (about 15.5 tons) of steel grate and I-beams as scrap. Narration: 'Fifty feet of steel, torched for scrap.' One outlet gave 40 by 15 feet; most say 50 by 20 (the label says 'about 50 ft').",
   "sources": [
    "cbs",
    "cbs2",
    "abc6",
    "claims",
    "whyy",
    "upi"
   ]
  },
  {
   "id": "K_photos",
   "type": "established",
   "nature": "fact",
   "text": "A recycling company contacted police after one of the men showed an employee photos of the bridge on his cell phone and said he had permission to take it apart; the brothers were arrested. Narration: 'One showed the scrapyard photos. It called police.'",
   "sources": [
    "cbs2",
    "abc",
    "abc6",
    "claims",
    "wpxi",
    "whyy"
   ]
  },
  {
   "id": "K_charged",
   "type": "established",
   "nature": "fact",
   "text": "Both brothers were charged in October 2011 with criminal mischief, theft, receiving stolen property and conspiracy and held on $25,000 bond. No plea, verdict or sentence found in any report (searched 20 Oct 2026): the reel says CHARGED, 'police say', AS OF OCT 2026. Label 'BOTH CHARGED · THEFT, CONSPIRACY · OCT 2011'.",
   "sources": [
    "cbs2",
    "abc6",
    "claims",
    "wpxi",
    "whyy",
    "cbspit"
   ]
  },
  {
   "id": "K_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter 81 %): the National Insurance Crime Bureau counted 25,083 metal-theft insurance claims in 2009-2011 against 13,861 in 2006-2008, an 81 % rise driven by metal prices (96 % of the claims were copper). Counter '81%', label 'US METAL-THEFT INSURANCE CLAIMS · 2009-11 vs 2006-08', NICB named.",
   "sources": [
    "secmag",
    "rectoday",
    "cdr",
    "pmpa"
   ]
  },
  {
   "id": "K_beach",
   "type": "established",
   "nature": "fact",
   "text": "Coral Spring, Trelawny, Jamaica, July 2008: an estimated 500 truckloads of white sand (the Mines and Geology Division later said no more than 140) vanished from the beach of a planned resort; police believed it was sold to rival resorts. Narration: 'In Jamaica, thieves trucked away a beach.' Label 'CORAL SPRING, JAMAICA · JULY 2008' with the truckload figures attributed. Nobody named.",
   "sources": [
    "mg",
    "rnz",
    "macleans",
    "observer",
    "gadling",
    "jpost"
   ]
  },
  {
   "id": "K_samples",
   "type": "established",
   "nature": "fact",
   "text": "Police took sand samples from other beaches for forensic comparison to find where the sand went; Deputy Commissioner Mark Shields called it a very complex investigation involving receivers, truck operators, organisers and suspected police collusion. Narration: 'Police tested rival beaches.' Callout 'SAND SAMPLES · rival beaches tested (BBC)'.",
   "sources": [
    "mg",
    "rnz",
    "macleans",
    "observer"
   ]
  },
  {
   "id": "K_nosuspects",
   "type": "established",
   "nature": "fact",
   "text": "Three months after the theft (October 2008) there was no sign of suspects or sand; the opposition alleged a cover-up and the developers suspended the project. Narration: 'Still no suspects.' Label 'OCT 2008: NO SAND, NO SUSPECTS' with 'no conviction found in reports as of Oct 2026'.",
   "sources": [
    "mg",
    "rnz",
    "macleans",
    "gadling"
   ]
  },
  {
   "id": "K_stop",
   "type": "established",
   "nature": "fact",
   "text": "Chilean Patagonia, early February 2012: police stopped a large refrigerated truck for a routine traffic violation (reported near Cochrane, Capitan Prat province, Aysen) and found about five tonnes of ice in the back. Narration: 'The strangest came by truck.' Label 'PATAGONIA, CHILE · FEB 2012'.",
   "sources": [
    "ccentral",
    "csm",
    "abcice",
    "cpost",
    "popsci",
    "register"
   ]
  },
  {
   "id": "K_ice",
   "type": "established",
   "nature": "fact",
   "text": "The ice, about five tonnes (outlets give 5 to nearly 6 tons), had been taken from the Jorge Montt glacier in Bernardo O'Higgins National Park; the driver was charged with theft and prosecutors weighed a charge under the national monuments law. Narration: 'A traffic stop. Five tons of glacier.' Accused only, never named, silhouette.",
   "sources": [
    "ccentral",
    "csm",
    "abcice",
    "cpost",
    "joy",
    "register"
   ]
  },
  {
   "id": "K_cocktails",
   "type": "established",
   "nature": "fact",
   "text": "Reports say the ice was bound for bars and restaurants in Santiago to be sold as designer cocktail ice, with a reported value of about 3 million pesos (roughly $6,000). Narration: 'Arrested. For cocktails, police say.' (the arrest is reported by every outlet) Label 'CHARGED WITH THEFT · POLICE SAY · ice valued about $6,000'.",
   "sources": [
    "ccentral",
    "csm",
    "abcice",
    "popsci",
    "register",
    "joy"
   ]
  },
  {
   "id": "K_fact",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: the Jorge Montt glacier retreated about 1 km (half a mile) between February 2010 and January 2011, recorded in 1,445 time-lapse photographs by glaciologist Andres Rivera's team; it is described as the fastest-retreating glacier in Chile. Card 'THE GLACIER HE TOOK FROM / RETREATED 1 KM IN ONE YEAR / 1,445 time-lapse photos, 2010-11 (AP)'.",
   "sources": [
    "foxap",
    "indiatv",
    "zme",
    "ccentral"
   ]
  },
  {
   "id": "K_value",
   "type": "established",
   "nature": "fact",
   "text": "The bridge was valued at about $100,000 (state police; the owner said replacing it would cost approximately $100,000); the complaint says the scrap fetched $5,179. Narration: 'Worth a hundred grand. Scrapped for five.'",
   "sources": [
    "cbs",
    "cbs2",
    "abc6",
    "claims",
    "whyy",
    "upi"
   ]
  }
 ],
