 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "In 2017 thieves came through the Paris catacombs (the old underground quarries) and drilled through the wall of a private apartment-building cellar in the 6th arrondissement, near the Luxembourg Gardens. Narration: 'Thieves tunnelled into a Paris wine cellar.' Headline 'A TUNNEL INTO / A PARIS WINE CELLAR'.",
   "sources": [
    "local_paris",
    "fox_ap",
    "decanter_paris",
    "db_paris",
    "atlas"
   ]
  },
  {
   "id": "K_shop",
   "type": "established",
   "nature": "fact",
   "text": "Night of Sunday 23 February 2020, Copenhagen: burglars got into the Michelin-starred restaurant Formel B's cellar through a neighbouring wine shop which they broke into first. Narration: 'But first, Copenhagen. Burglars broke into a wine shop.'",
   "sources": [
    "local_dk",
    "local_dk2",
    "decanter_cph",
    "vinepair_cph"
   ]
  },
  {
   "id": "K_nothing",
   "type": "established",
   "nature": "fact",
   "text": "They took nothing from the wine shop. Narration: 'And stole nothing from it.' Label 'THE SHOP: NOTHING TAKEN'.",
   "sources": [
    "local_dk",
    "local_dk2",
    "vinepair_cph"
   ]
  },
  {
   "id": "K_formelb",
   "type": "established",
   "nature": "fact",
   "text": "From the shop they broke a hole through the (brick) wall into Formel B's wine cellar and took 50-60 rare bottles (incl. Domaine de la Romanee-Conti and Domaine Leroy), about DKK 1.5 million; about a third later surfaced with a German dealer. Narration: 'It was just the way into the Michelin restaurant next door.' Label 'FORMEL B · 50-60 RARE BOTTLES'.",
   "sources": [
    "decanter_cph",
    "local_dk",
    "vinepair_cph",
    "weinplus_cph"
   ]
  },
  {
   "id": "K_tail",
   "type": "established",
   "nature": "fact",
   "text": "October 2020, Paris: thieves got into the building next to the fine-wine shop Les Caves de Taillevent and cut a hole of about 50 cm in the wall between the two. Narration: 'In Paris, thieves cut a hole from next door.' (rehook 'Wine thieves love walls.' is editorial).",
   "sources": [
    "db_tail",
    "wlc_tail",
    "dm_tail"
   ]
  },
  {
   "id": "K_rod",
   "type": "established",
   "nature": "fact",
   "text": "They used a rod to 'fish' about 20 bottles of grand cru wine (about EUR 50,000) out through the hole. Narration: 'Then fished the bottles out. With a rod.' Label 'ABOUT 20 BOTTLES · EUR 50,000'.",
   "sources": [
    "db_tail",
    "wlc_tail",
    "dm_tail"
   ]
  },
  {
   "id": "K_alarm",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: by fishing through the hole they avoided setting off the alarm and the cameras and never entered the shop. Card 'THE ALARM NEVER WENT OFF / THEY NEVER SET FOOT INSIDE'.",
   "sources": [
    "db_tail",
    "wlc_tail"
   ]
  },
  {
   "id": "K_catacombs",
   "type": "established",
   "nature": "fact",
   "text": "The Paris thieves came through the catacombs, the tunnel network under the city (cellar near the Luxembourg Gardens, 6th arrondissement). Narration: 'That tunnel? It came from the catacombs.' Label 'PARIS 6TH · 2017'.",
   "sources": [
    "local_paris",
    "fox_ap",
    "chn_ap",
    "decanter_paris",
    "atlas"
   ]
  },
  {
   "id": "K_drill",
   "type": "established",
   "nature": "fact",
   "text": "They drilled through the (limestone) wall into a private apartment cellar. Narration: 'They drilled straight into a private cellar.'",
   "sources": [
    "local_paris",
    "fox_paris",
    "decanter_paris",
    "atlas"
   ]
  },
  {
   "id": "K_300",
   "type": "established",
   "nature": "fact",
   "text": "About 300 bottles were taken (reports say 'about 300' / 'more than 300'; The Local's headline says 250), worth about EUR 250,000 (France Info via The Local; other outlets convert to $300,000-375,000). Narration (hook): 'And stole about 300 bottles.' Counter '300 BOTTLES', sub 'about EUR 250,000'.",
   "sources": [
    "local_paris",
    "fox_ap",
    "decanter_paris",
    "db_paris",
    "vinepair_paris"
   ]
  },
  {
   "id": "K_scouted",
   "type": "established",
   "nature": "fact",
   "text": "Police said the thieves must have scouted the site: they did not drill that particular wall by accident. Narration (paraphrase, no quotation): 'Police said that wall was no accident.'",
   "sources": [
    "local_paris",
    "fox_ap",
    "chn_ap",
    "atlas"
   ]
  },
  {
   "id": "K_missing",
   "type": "established",
   "nature": "fact",
   "text": "No arrests and no recovered bottles were reported (contemporary reports: the thieves were still at large; nothing later found on 18 October 2026). Narration: 'No arrests. The bottles? Still missing.' On screen 'AS OF OCT 2026: NO ARRESTS REPORTED'.",
   "sources": [
    "local_paris",
    "fox_ap",
    "atlas",
    "db_paris"
   ]
  },
  {
   "id": "K_part3",
   "type": "established",
   "nature": "fact",
   "text": "PART 3 TEASE (end card): Rudy Kurniawan blended fake 'rare' wines in his California home kitchen; FBI agents raided the house in Arcadia in March 2012 and found thousands of counterfeit labels; convicted of fraud in December 2013 and sentenced to 10 years in August 2014. End card 'PART 3: FAKE WINE MADE IN A KITCHEN'.",
   "sources": [
    "cbs_rk",
    "decanter_rk",
    "npr_rk",
    "nbc_rk"
   ]
  }
 ],
