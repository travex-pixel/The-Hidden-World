 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "Michelle Parker, 33, vanished on 17 November 2011, hours after a pre-taped episode of 'The People's Court' featuring her and her ex-fiance aired. Narration: 'After her People's Court episode, she vanished.' Headline 'VANISHED AFTER HER / PEOPLE'S COURT EPISODE'.",
   "sources": [
    "ap_abc30",
    "ap_wcax",
    "tvinsider",
    "gray_wcax"
   ]
  },
  {
   "id": "K_arrest",
   "type": "established",
   "nature": "fact",
   "text": "Orlando police arrested Dale Smith Jr., 55, on Wednesday 14 October 2026, nearly 15 years after the disappearance. Narration: 'Fifteen years later, police made an arrest.' / 'Then police arrested the man who sued her.' Label 'DALE SMITH JR., 55 · CHARGED'.",
   "sources": [
    "ap_abc30",
    "tvinsider",
    "gray_wcax",
    "fox"
   ]
  },
  {
   "id": "K_ring",
   "type": "established",
   "nature": "fact",
   "text": "On the show, Smith had sued Parker over a $5,000 engagement ring he said was lost when she threw it at him during an argument. Narration: 'Her ex-fiance had sued her over a $5,000 ring.'",
   "sources": [
    "ap_abc30",
    "ap_boston",
    "tvinsider"
   ]
  },
  {
   "id": "K_verdict",
   "type": "established",
   "nature": "fact",
   "text": "The TV judge found both responsible for the ring's loss and ordered Parker to pay Smith $2,500, half its value. On screen only (the TV-verdict card).",
   "sources": [
    "ap_boston",
    "ap_wcax",
    "ap_abc30"
   ]
  },
  {
   "id": "K_twins",
   "type": "established",
   "nature": "reported",
   "text": "On 17 November 2011 Parker dropped off their 3-year-old twins at Smith's home; police say he was the last known person to see or hear from her. Narration: 'That day, Michelle Parker dropped their twins at his home.' Label sub 'Police: the last known to see her'.",
   "sources": [
    "gray_wcax",
    "tvinsider",
    "fox",
    "nbc"
   ]
  },
  {
   "id": "K_car",
   "type": "established",
   "nature": "fact",
   "text": "Her vehicle was found abandoned the next day. Narration: 'Next day, her car was found abandoned.'",
   "sources": [
    "ap_abc30",
    "nbc",
    "ap_boston"
   ]
  },
  {
   "id": "K_phone",
   "type": "established",
   "nature": "fact",
   "text": "Her cellphone was later recovered from a lake south of Orlando. Narration: 'Her phone turned up in a lake.'",
   "sources": [
    "ap_abc30",
    "nbc",
    "ap_boston"
   ]
  },
  {
   "id": "K_never",
   "type": "established",
   "nature": "fact",
   "text": "Her body has never been found; police continue to search. Narration: 'Her body has never been found.' Memorial card 'REMEMBERING MICHELLE PARKER, 33'.",
   "sources": [
    "ap_abc30",
    "gray_wcax",
    "nbc"
   ]
  },
  {
   "id": "K_years",
   "type": "established",
   "nature": "fact",
   "text": "Smith was long considered a suspect (police named him a prime suspect in 2011) but was not arrested or charged until October 2026. Counter '15 YEARS' with label 'NOV 2011 - OCT 2026 · NO CHARGE'.",
   "sources": [
    "fox",
    "wokv_2011",
    "gray_wcax"
   ]
  },
  {
   "id": "K_charge",
   "type": "established",
   "nature": "allegation",
   "text": "The charge is second-degree murder; police say the evidence points to Smith. He is presumed innocent. Narration: 'The charge? Second-degree murder.'",
   "sources": [
    "ap_abc30",
    "fox",
    "tvinsider"
   ]
  },
  {
   "id": "K_tech",
   "type": "established",
   "nature": "reported",
   "text": "Police credit an expanded team's fresh look over the past year and advances in digital forensics; a detective said technology now better interprets older data from cars, phones and computers, revealing more detailed location data and communications. Narration: 'Police credit new forensics on old phone and car data.'",
   "sources": [
    "nbc",
    "gray_wcax",
    "tvinsider",
    "fox"
   ]
  },
  {
   "id": "K_plea",
   "type": "established",
   "nature": "fact",
   "text": "Smith pleaded not guilty at his first appearance on Thursday 15 October 2026. Narration: 'He has pleaded not guilty.'",
   "sources": [
    "wftv",
    "courttv"
   ]
  },
  {
   "id": "K_defence",
   "type": "established",
   "nature": "reported",
   "text": "His attorney, Rajan Joshi, said the state may not meet its burden of proof and that the investigation focused almost exclusively on Smith from the beginning; he maintains his innocence. On screen (defence card).",
   "sources": [
    "ap_abc30",
    "ns13",
    "gray_wcax"
   ]
  },
  {
   "id": "K_bond",
   "type": "established",
   "nature": "fact",
   "text": "A judge ordered him held without bond pending a detention hearing, not yet scheduled as of the latest reports. Labels 'HELD WITHOUT BOND' and 'AS OF OCT 2026'.",
   "sources": [
    "ap_abc30",
    "ns13",
    "tvinsider",
    "wftv"
   ]
  },
  {
   "id": "K_close",
   "type": "established",
   "nature": "editorial",
   "text": "Closing line (editorial, about the TV-show coincidence only): 'Fifteen years later, a courtroom again. A real one.' The case now moves through a real criminal court (the TV case was a small-claims show).",
   "sources": [
    "ap_abc30",
    "wftv"
   ]
  }
 ],
