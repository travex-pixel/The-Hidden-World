 "claims": [
  {
   "id": "B_shutdown",
   "type": "established",
   "nature": "fact",
   "text": "On 19 April 2013 Gov. Deval Patrick asked more than a million greater Boston residents to shelter in place (a voluntary order; NBC/CBS: close to 1 million), mass transit was suspended, and the order was lifted at about 6 p.m. after the search of the Watertown neighbourhood was 'not fruitful'. The Globe itself calls it the 'decision to shut down Boston for manhunt'.",
   "sources": [
    "globe_2014",
    "nbc_hayes",
    "cbs_capture",
    "npr_hunt"
   ]
  },
  {
   "id": "B_found",
   "type": "established",
   "nature": "fact",
   "text": "After the order was lifted, a Watertown homeowner (David Henneberry; not named on screen) noticed something amiss with the boat in his backyard, went out to check it, found the cover's strap looser than usual, lifted the wrap, saw blood inside and called 911. The drawn boat is generic, with no name, number or make.",
   "sources": [
    "cnn_owner",
    "nbc_owner",
    "cbs_capture",
    "nbc_dies"
   ]
  },
  {
   "id": "B_toll",
   "type": "established",
   "nature": "fact",
   "text": "Two bombs near the marathon finish line on Boylston Street on 15 April 2013 killed three people and injured more than 260 (FBI: 'killing three and injuring scores more'; DOJ: 'killing three people, maiming 17, and injuring hundreds more'). The victims are named only on the memorial card and are never shown.",
   "sources": [
    "aljazeera_2015",
    "wbur_2015",
    "scripps_2015",
    "fbi_case",
    "doj_2015"
   ]
  },
  {
   "id": "B_photos",
   "type": "established",
   "nature": "fact",
   "text": "On 18 April 2013, three days after the bombing, the FBI released images of two suspects (Suspect 1 and Suspect 2); its website crashed under the demand.",
   "sources": [
    "abc7_photos",
    "salon_photos",
    "time_photos"
   ]
  },
  {
   "id": "B_night",
   "type": "established",
   "nature": "fact",
   "text": "That night (about 10:20-10:30 p.m. on 18 April) MIT police officer Sean Collier was shot and killed in Cambridge; the suspects carjacked an SUV; in a shootout with police in Watertown in the early hours of 19 April the older brother, Tamerlan Tsarnaev, died. Narration: 'a campus police officer was killed' and 'one suspect died in a shootout' (summary only).",
   "sources": [
    "nbc_collier",
    "cbs_collier",
    "cbs_collier_id",
    "fbi_case",
    "npr_hunt"
   ]
  },
  {
   "id": "B_search",
   "type": "established",
   "nature": "fact",
   "text": "A 20-block area of Watertown was cordoned off and searched by police and SWAT teams during 19 April; the search found nothing (card: 'A 20-BLOCK SEARCH · NOTHING').",
   "sources": [
    "salon_custody",
    "nbc_owner",
    "globe_2014"
   ]
  },
  {
   "id": "B_hour",
   "type": "established",
   "nature": "fact",
   "text": "About an hour after the shelter-in-place order was lifted, the homeowner went out to his boat (NBC: 'About an hour after the order lifted'; CNN; UPI citing the Globe).",
   "sources": [
    "nbc_owner",
    "cnn_owner",
    "upi_globe",
    "nbc_hayes"
   ]
  },
  {
   "id": "B_capture",
   "type": "established",
   "nature": "fact",
   "text": "Dzhokhar Tsarnaev was found hiding inside the boat, wounded, and was taken into custody at about 8:45 p.m. on 19 April 2013 (Long Island Press: about 8:45 p.m.; Salon: cheers at 8:43; CBS: just before 9 p.m.) after a standoff of about an hour; police helicopters' thermal imaging confirmed someone inside. Nothing of the standoff is depicted.",
   "sources": [
    "lip_arrest",
    "salon_custody",
    "cbs_standoff",
    "cbs_capture",
    "fbi_case"
   ]
  },
  {
   "id": "B_note",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY: a note he had written in pencil inside the boat was shown to jurors at his trial in March 2015; its content is not quoted.",
   "sources": [
    "npr_note",
    "cbs_note",
    "globe_note"
   ]
  },
  {
   "id": "B_verdict",
   "type": "established",
   "nature": "fact",
   "text": "A federal jury convicted Dzhokhar Tsarnaev on all 30 counts in April 2015; the jury returned a death verdict on 15 May 2015, and Judge George A. O'Toole Jr. formally imposed the death sentence (plus consecutive life terms) in June 2015.",
   "sources": [
    "wbur_2015",
    "scripps_2015",
    "aljazeera_2015",
    "npr_verdict",
    "doj_2015"
   ]
  },
  {
   "id": "B_appeals",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY: the First Circuit vacated the death sentence in July 2020; the Supreme Court reinstated it in March 2022; in March 2024 the First Circuit sent the case back to the trial judge to investigate alleged juror bias; in July-August 2025 a panel refused to remove the judge and the defence sought en banc rehearing. No later ruling found in extracts as of 2026-10-12: stated as 'sentenced to death; appeals continue'.",
   "sources": [
    "nbc_2020",
    "nbc_2024",
    "globe_2025",
    "wbur_2025",
    "globe_enbanc"
   ]
  },
  {
   "id": "B_victims",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY (memorial): Krystle Campbell (29), Lu Lingzi (23) and Martin Richard (8) were killed by the bombs; MIT police officer Sean Collier (26) was killed on 18 April 2013.",
   "sources": [
    "bpl_victims",
    "upi_memorial",
    "boston25_garden",
    "cbs_collier_id",
    "doj_2015"
   ]
  }
 ],
