 "claims": [
  {
   "id": "D_hook",
   "type": "established",
   "nature": "fact",
   "text": "Over about three weeks in October 2002 (2-22 October) two snipers shot people at random in the Washington, DC area; the FBI calls it '23 days of random attacks'. The attacks ended with the arrests at the rest stop on 24 October 2002.",
   "sources": [
    "fbi_pt2",
    "britannica",
    "cbc",
    "wtop_2026"
   ]
  },
  {
   "id": "D_toll",
   "type": "established",
   "nature": "fact",
   "text": "In the October 2002 attacks ten people were killed and three wounded, in Maryland, Virginia and the District of Columbia (Travel Channel; CBC; Britannica: 'killed 10 people and injured 3'). Victims are not named or shown.",
   "sources": [
    "travel",
    "cbc",
    "britannica",
    "nbcw_remember"
   ]
  },
  {
   "id": "D_truck",
   "type": "established",
   "nature": "fact",
   "text": "The early lookout was for a white box truck (DC police chief Charles Ramsey, CNN) with one or two suspects; reports also described a white van. Police had conflicting sightings and even stopped the Caprice on 3 October and let it go (card: 'LOOKOUT: A WHITE BOX TRUCK').",
   "sources": [
    "cnn_1027",
    "britannica",
    "nbcw_remember"
   ]
  },
  {
   "id": "D_call",
   "type": "established",
   "nature": "fact",
   "text": "On 17 October 2002 a caller to the task-force tip line, claiming to be the sniper, told investigators to look into a liquor-store shooting in Montgomery, Alabama (21 September 2002, one woman killed and one wounded, first treated as a robbery). The FBI: the break came 'ironically, from the snipers themselves'. No words of the call are quoted.",
   "sources": [
    "fbi_pt2",
    "fox_call",
    "ids_ap",
    "mg_ap"
   ]
  },
  {
   "id": "D_print",
   "type": "established",
   "nature": "fact",
   "text": "A fingerprint on a magazine dropped at the Montgomery scene was sent to the FBI Laboratory and matched in the FBI's fingerprint database to Lee Boyd Malvo, then 17, whose prints were on file from an immigration arrest in Washington State (FBI; Nextgov; Fox/AP). Sources differ on whether the item was a gun magazine or catalogue; narration says 'a fingerprint from that scene'.",
   "sources": [
    "fbi_pt2",
    "nextgov",
    "fox_cracked",
    "ids_ap"
   ]
  },
  {
   "id": "D_car",
   "type": "established",
   "nature": "fact",
   "text": "Malvo's record led investigators to John Allen Muhammad (an earlier tip had named him); on 22 October 2002 an FBI records search found a blue 1990 Chevrolet Caprice registered to Muhammad in New Jersey.",
   "sources": [
    "fbi_pt2",
    "cnn_killing",
    "nova_timeline"
   ]
  },
  {
   "id": "D_plate",
   "type": "established",
   "nature": "fact",
   "text": "A lookout for the blue (or burgundy) 1990 Chevrolet Caprice and its New Jersey plate went out on the night of Wednesday 23 October 2002 and was reported on radio and television; the plate itself is never shown on screen.",
   "sources": [
    "cnn_killing",
    "nova_timeline",
    "wtop_2026",
    "cbs_trucker"
   ]
  },
  {
   "id": "D_rest",
   "type": "established",
   "nature": "fact",
   "text": "At about 1 a.m. on 24 October 2002 a truck driver (Ron Lantz; not named on screen) saw the Caprice at a rest stop off Interstate 70 near Myersville, Maryland, and called 911; trucks were pulled across the exit; police found two men asleep in the car and arrested Muhammad and Malvo without incident (custody at about 3:19-3:30 a.m.). An early CNN transcript credited 'a motorist' and a rest-stop attendant; narration says 'a trucker'.",
   "sources": [
    "cnn_bn04",
    "wtop_2026",
    "nova_timeline",
    "cbs_trucker",
    "fox_trucker",
    "trucknews",
    "officer_com",
    "nbc_court"
   ]
  },
  {
   "id": "D_trunk",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY: a hole had been cut in the car's body above the rear plate so a rifle could be fired from inside the trunk (WTOP; NBC Washington; CNN). Said only as 'THE TRUNK HAD BEEN MODIFIED'; no weapon is shown.",
   "sources": [
    "wtop_2026",
    "nbcw_remember",
    "cnn_killing"
   ]
  },
  {
   "id": "D_muhammad",
   "type": "established",
   "nature": "fact",
   "text": "John Allen Muhammad was convicted in Virginia in November 2003 of the murder of Dean Harold Meyers, sentenced to death in March 2004 and executed by lethal injection at Greensville Correctional Center on 10 November 2009.",
   "sources": [
    "abc_exec",
    "nbc_exec",
    "cbs_exec",
    "abc7_exec"
   ]
  },
  {
   "id": "D_malvo",
   "type": "established",
   "nature": "fact",
   "text": "Lee Boyd Malvo, 17 at the time, was sentenced to life without parole in Virginia (March 2004) and Maryland (2006). After Supreme Court rulings on juvenile life sentences, a federal judge ordered a Virginia resentencing in 2017 and Maryland's highest court ordered a Maryland resentencing in August 2022; that resentencing has stalled because Virginia will not transfer him, and on 25 August 2026 the Maryland Supreme Court refused to hear his appeal. Status as of 2026-10-13: serving life in Virginia; card: 'RESENTENCING FIGHTS CONTINUE'.",
   "sources": [
    "cnn_malvo",
    "nbc_malvo_2017",
    "npr_2022",
    "wusa9_2022",
    "mdmatters_2026",
    "dailyrecord_2026"
   ]
  },
  {
   "id": "D_memorial",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY (memorial): ten people died in the October 2002 attacks in Maryland, Virginia and Washington, DC. They are not named or depicted.",
   "sources": [
    "travel",
    "cbc",
    "britannica"
   ]
  }
 ],
