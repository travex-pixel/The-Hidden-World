 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "Announced 29 January 2020: a smuggling tunnel from Tijuana under the border to Otay Mesa (San Diego) with an elevator at the entrance (Border Patrol), plus rails, ventilation, power and drainage. Narration: 'Smugglers built a border tunnel with an elevator.' Headline 'A BORDER SMUGGLING TUNNEL / WITH AN ELEVATOR'.",
   "sources": [
    "ap20",
    "br20",
    "nbc20",
    "lp20"
   ]
  },
  {
   "id": "K_list",
   "type": "established",
   "nature": "editorial",
   "text": "Editorial framing: the elevator tunnel is the third of three verified border-tunnel cases told in this episode. Narration: 'It is number 3 on this list.'",
   "sources": [
    "ap20",
    "hc14",
    "cnn22"
   ]
  },
  {
   "id": "K_pool",
   "type": "established",
   "nature": "fact",
   "text": "May 1990: law enforcement raided a house in Agua Prieta, Mexico, and a warehouse in Douglas, Arizona, joined by a tunnel whose entrance was under a pool table in the house's game room. Narration: 'First, 1990: a secret tunnel under a pool table.'",
   "sources": [
    "hc14",
    "pi99",
    "lr14",
    "nbc18"
   ]
  },
  {
   "id": "K_lift",
   "type": "established",
   "nature": "fact",
   "text": "The pool table sat on a concrete floor panel (about 10 x 10 ft) that a hydraulic system lifted to open the entrance. Narration: 'Hydraulics lifted the floor, pool table and all.'",
   "sources": [
    "hc14",
    "pi99",
    "lr14"
   ]
  },
  {
   "id": "K_rail",
   "type": "established",
   "nature": "fact",
   "text": "May 2022: a tunnel from Tijuana to a warehouse in Otay Mesa, San Diego, about 1,744 ft long and 61 ft deep, with reinforced walls, a rail system, electricity and ventilation (U.S. Attorney). Narration: 'But the next tunnel had its own railway.' (editorial rehook) / '61 feet down, to a San Diego warehouse.'",
   "sources": [
    "cnn22",
    "fox22",
    "tn22",
    "ice22"
   ]
  },
  {
   "id": "K_follow",
   "type": "established",
   "nature": "fact",
   "text": "HSI agents watching a National City stash house followed people (one or two, by vehicle; accounts vary) from it to the Otay Mesa warehouse where the tunnel exit was found. Narration: 'Agents just followed them there.'",
   "sources": [
    "cnn22",
    "tn22",
    "ice22"
   ]
  },
  {
   "id": "K_ton",
   "type": "established",
   "nature": "fact",
   "text": "1,762 lb of cocaine (almost a ton) was seized, with methamphetamine and heroin; six people were charged (charged only; not named). Narration: 'Almost a ton of cocaine.'",
   "sources": [
    "cnn22",
    "fox22",
    "tn22",
    "ice22"
   ]
  },
  {
   "id": "K_found",
   "type": "established",
   "nature": "fact",
   "text": "The 2020 tunnel is the longest smuggling tunnel found on the U.S. Southwest border; found in August 2019 when Mexican authorities located its entrance in a small industrial building in Tijuana. Narration: 'Then came the longest one ever found.'",
   "sources": [
    "ap20",
    "nbc20",
    "eu20",
    "br20"
   ]
  },
  {
   "id": "K_long",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC: about 4,309 ft long (Border Patrol). Narration: '4,309 feet.' Counter '4,309 FT'.",
   "sources": [
    "ap20",
    "br20",
    "nbc20",
    "cbc20"
   ]
  },
  {
   "id": "K_deep",
   "type": "established",
   "nature": "fact",
   "text": "It ran at an average depth of about 70 ft, well below the border wall. Narration: '70 feet under the border.'",
   "sources": [
    "ap20",
    "br20",
    "cbc20"
   ]
  },
  {
   "id": "K_kit",
   "type": "established",
   "nature": "fact",
   "text": "It had a rail and cart system, forced-air ventilation, high-voltage electrical cables and panels, drainage and an elevator at the entrance. Narration: 'Rails, power, and an elevator at the entrance.'",
   "sources": [
    "ap20",
    "fox20",
    "br20",
    "lp20"
   ]
  },
  {
   "id": "K_sand",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: agents found several hundred sandbags blocking the suspected former exit in the Otay Mesa warehouse district. Narration: 'The old exit? Likely sealed with sandbags.' (suspected, as reported)",
   "sources": [
    "ap20",
    "br20",
    "fox20"
   ]
  },
  {
   "id": "K_punch",
   "type": "established",
   "nature": "fact",
   "text": "An incomplete offshoot (a side branch that stops after several hundred feet) suggested smugglers were building a replacement exit; no arrests were reported at the announcement. Closing line: 'The new exit was still not finished.'",
   "sources": [
    "ap20",
    "br20",
    "fox20"
   ]
  },
  {
   "id": "K_part6",
   "type": "established",
   "nature": "fact",
   "text": "PART 6 TEASE (end card): in 2019 smuggling crews sawed through new steel bollards of the border wall and hid the cuts with tinted putty, agents told the Washington Post. End card 'PART 6: WALL CUTS HIDDEN WITH PUTTY'.",
   "sources": [
    "inq19",
    "tn19",
    "fox19"
   ]
  }
 ],
