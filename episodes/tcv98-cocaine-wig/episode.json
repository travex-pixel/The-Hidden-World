 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "June 2019 (announced 16-17 July 2019), Barcelona-El Prat airport: Spain's National Police arrested a 65-year-old Colombian man arriving from Bogota with a sealed package of cocaine taped to his head under his toupee. Narration: 'A smuggler taped cocaine under his wig.' Headline 'COCAINE / UNDER HIS WIG'. Label 'BARCELONA AIRPORT · 2019', sub 'Flight from Bogota · National Police'. Not named; never shown with a face.",
   "sources": [
    "thelocal",
    "npr",
    "cbs",
    "espectador"
   ]
  },
  {
   "id": "K_weight",
   "type": "established",
   "nature": "fact",
   "text": "The package held 503 grams of cocaine (half a kilo, 1.1 lb), worth more than 30,000 euros. Narration: 'Half a kilo, worth over 30,000 euros.'",
   "sources": [
    "thelocal",
    "npr",
    "cbs",
    "espectador"
   ]
  },
  {
   "id": "K_lift",
   "type": "established",
   "nature": "fact",
   "text": "The perfectly sealed package was taped (firmly attached) to the top of his head under the toupee. Narration (gotcha): 'Then police lifted it. A sealed packet underneath.' Label 'TAPED TO HIS HEAD'.",
   "sources": [
    "thelocal",
    "npr",
    "espectador"
   ]
  },
  {
   "id": "K_nerves",
   "type": "established",
   "nature": "fact",
   "text": "Police said the man drew officers' attention because he was considerably nervous and his wig was of disproportionate size. Narration: 'Nerves and an oversized wig gave him away.' Label sub 'Police statement'.",
   "sources": [
    "cbs",
    "thelocal",
    "espectador"
   ]
  },
  {
   "id": "K_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter 503 G): the weight of the cocaine under the toupee. Counter '503 G' with the label 'COCAINE UNDER THE WIG'.",
   "sources": [
    "thelocal",
    "npr",
    "cbs"
   ]
  },
  {
   "id": "K_charged",
   "type": "established",
   "nature": "procedure",
   "text": "He was charged with a crime against public health and placed at the disposal of the judicial authority; no verdict is reported. Label 'CHARGED · NOT NAMED'.",
   "sources": [
    "npr",
    "cbs",
    "thelocal"
   ]
  },
  {
   "id": "K_strangest",
   "type": "established",
   "nature": "fact",
   "text": "Editorial rehook: the fake buttocks are a stranger hiding place than a toupee (opinion, not a fact claim), and the Lisbon seizure (about a kilo) is bigger than Barcelona's 503 g. Narration: 'But that was not the strangest.'",
   "sources": [
    "fox",
    "journal",
    "npr",
    "cbs"
   ]
  },
  {
   "id": "K_butt",
   "type": "established",
   "nature": "fact",
   "text": "February 2018, Lisbon airport: Portugal's anti-narcotics police detained a man carrying cocaine in two cushion-like fake buttocks attached to a pair of swimming trunks (Fox News: more than two pounds; TheJournal.ie: about a kilo). Narration: 'In Lisbon: fake buttocks, stuffed with cocaine.' Label 'LISBON AIRPORT · FEB 2018', sub 'About a kilo, police say'. Not named; silhouette only.",
   "sources": [
    "fox",
    "journal"
   ]
  },
  {
   "id": "K_station",
   "type": "established",
   "nature": "allegation",
   "text": "A second man was arrested soon after at a train station; police suspected he was to receive the drugs. Both face drug-trafficking charges; neither is named. Narration (gotcha): 'Police caught him, and a second man.' Label 'SECOND MAN · AT A TRAIN STATION', sub 'Police say he was to receive it'.",
   "sources": [
    "fox",
    "journal"
   ]
  },
  {
   "id": "K_belly",
   "type": "established",
   "nature": "fact",
   "text": "September 2013, Bogota El Dorado airport: Colombia's anti-narcotics police arrested a 28-year-old Canadian woman before a flight to Toronto with cocaine in a fake latex pregnancy belly. Narration: 'The strangest? A fake pregnant belly.' Label 'BOGOTA AIRPORT · SEPT 2013', sub 'Anti-narcotics police'. Not named; silhouette only.",
   "sources": [
    "gulfbog",
    "colrep",
    "semana",
    "chinadaily"
   ]
  },
  {
   "id": "K_months",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: she told the inspector she was seven months pregnant. Card 'SHE SAID SHE WAS / SEVEN MONTHS / PREGNANT'.",
   "sources": [
    "colrep",
    "chinadaily",
    "gulfbog"
   ]
  },
  {
   "id": "K_cold",
   "type": "established",
   "nature": "fact",
   "text": "During the pat-down an officer noticed her belly was very hard and extremely cold; a search found the latex belly. Narration (gotcha): 'It felt cold and hard.' Label 'COLD + HARD · IN THE PAT-DOWN'.",
   "sources": [
    "gulfbog",
    "colrep",
    "semana",
    "chinadaily"
   ]
  },
  {
   "id": "K_kilos",
   "type": "established",
   "nature": "fact",
   "text": "The fake belly held two kilograms of cocaine (two 1 kg bags), worth about US$60,000 in Canada. Narration: 'Police found two kilos.' Label 'TWO KILOS · IN LATEX'.",
   "sources": [
    "colrep",
    "chinadaily",
    "gulfbog"
   ]
  },
  {
   "id": "K_toupee",
   "type": "established",
   "nature": "fact",
   "text": "Spanish police called the Barcelona case 'Operation Toupee' ('operacion peluquin'). Narration (callback): 'Police called it Operation Toupee.' Stamp 'OPERATION TOUPEE'.",
