 "claims": [
  {
   "id": "M_hook",
   "type": "established",
   "nature": "fact",
   "text": "Jerome P. 'Jerry' Jacobson, director of security at Simon Marketing (the firm that ran McDonald's promotional games), stole high-value winning game pieces that he was responsible for securing. Narration: 'The prize guard was the thief.' Last line: 'This time, someone else was the guard.'",
   "sources": [
    "doj_2001",
    "wt_2001",
    "wdun_2003",
    "dailybeast"
   ]
  },
  {
   "id": "M_total",
   "type": "established",
   "nature": "fact",
   "text": "The September 2001 indictment alleged that he embezzled more than $20 million worth of high-value winning game pieces; later reporting puts the total at more than $24 million. Narration: 'Over 20 million dollars in prizes.'",
   "sources": [
    "upi_2001",
    "tampa_2001",
    "dailybeast",
    "wsb"
   ]
  },
  {
   "id": "M_cop",
   "type": "established",
   "nature": "fact",
   "text": "Before corporate security he was briefly a police officer in Hollywood, Florida (reported as about a year, ending after an injury around 1980). Narration: 'He was a former cop who guarded McDonald's Monopoly pieces.'",
   "sources": [
    "dailybeast",
    "newsweek"
   ]
  },
  {
   "id": "M_job",
   "type": "established",
   "nature": "fact",
   "text": "As Simon Marketing's director of security he was in charge of the security of the McDonald's game pieces (Monopoly and other games), printed by Dittler Brothers in Georgia.",
   "sources": [
    "wt_2001",
    "wdun_2003",
    "dailybeast",
    "axios"
   ]
  },
  {
   "id": "M_steal",
   "type": "established",
   "nature": "fact",
   "text": "He took the high-value winning pieces; at sentencing he testified that he took most of the high-value pieces issued from 1995 to 2001; reporting dates the first thefts to 1989.",
   "sources": [
    "wdun_2003",
    "yahoo_2003",
    "dailybeast",
    "axios"
   ]
  },
  {
   "id": "M_network",
   "type": "established",
   "nature": "fact",
   "text": "He passed the pieces to relatives, friends and recruited 'winners', who redeemed them and gave him a cut.",
   "sources": [
    "upi_2001",
    "dailybeast",
    "axios",
    "ajc"
   ]
  },
  {
   "id": "M_cash",
   "type": "established",
   "nature": "fact",
   "text": "Some recruits paid him cash upfront for a piece, reported as upward of $50,000 (Axios: kickbacks of $45,000 or $50,000). Narration: 'Some paid him 50,000 dollars, upfront.'",
   "sources": [
    "dailybeast",
    "axios",
    "cnbc"
   ]
  },
  {
   "id": "M_years",
   "type": "established",
   "nature": "fact",
   "text": "The scheme is reported to have run for about 12 years, 1989 to 2001 (the indictment: 'as far back as the late 1980s'), until the 2001 arrests. Narration: 'For twelve years, nobody stopped him.'",
   "sources": [
    "dailybeast",
    "axios",
    "wsb",
    "upi_2001"
   ]
  },
  {
   "id": "M_tip",
   "type": "established",
   "nature": "fact",
   "text": "The investigation began with a tip to the FBI's Jacksonville office in 2000.",
   "sources": [
    "wsb",
    "ajc",
    "cnbc"
   ]
  },
  {
   "id": "M_crew",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: during the investigation, FBI agents posed as a McDonald's film crew to visit and film one of the 'winners' at home. Narration: 'Agents posed as a McDonald's film crew.'",
   "sources": [
    "dailybeast",
    "newsweek"
   ]
  },
  {
   "id": "M_arrest",
   "type": "established",
   "nature": "fact",
   "text": "On 21 August 2001 the Justice Department and FBI announced the arrests of eight people, Jacobson among them, in operation 'Final Answer', charged with conspiracy to commit mail fraud. Narration: 'In 2001, they arrested him and seven others.'",
   "sources": [
    "doj_2001",
    "doj_speech",
    "cnn_2001",
    "abc_2001"
   ]
  },
  {
   "id": "M_sentence",
   "type": "established",
   "nature": "fact",
   "text": "He pleaded guilty to conspiracy to commit mail fraud and two counts of mail fraud and in January 2003, aged 59, was sentenced to 37 months in prison (restitution reported as more than $13.4 million). Narration: 'He then got 37 months in prison.'",
   "sources": [
    "wdun_2003",
    "yahoo_2003",
    "ajc"
   ]
  },
  {
   "id": "M_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (FTC consumer advice): real prizes are free, so paying to collect is a sign of a scam; scammers ask for gift cards, wire transfers, cash or crypto; there is no reason to give a bank account or card number to claim a prize. Rows: 'REAL PRIZES ARE FREE', 'NO GIFT CARDS OR WIRES', 'NEVER GIVE BANK DETAILS'.",
   "sources": [
    "ftc_prize",
    "ftc_alert",
    "sj_da"
   ]
  },
  {
   "id": "M_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): per the FTC's most recent data at the time of its April 2023 consumer alert, people reported losing $301 million to prize, sweepstakes and lottery fraud, an average of $907 each (the FTC counts reports to it from consumers in America). Narration: 'Americans reported losing 301 million to fake prizes.' (the counter shows the dollar sign)",
   "sources": [
    "ftc_alert",
    "sj_da"
   ]
  }
 ],
