   "type": "established",
   "nature": "fact",
   "text": "While officers were still at the home, potential buyers arrived, drawn by online ads. Narration: 'Then buyers showed up. Mid-search.'",
   "sources": [
    "lapd",
    "abc7",
    "lbpost"
   ]
  },
  {
   "id": "K_gold",
   "type": "established",
   "nature": "fact",
