   "sources": [
    "gizmodo",
    "designboom",
    "cheddar"
   ]
  },
  {
   "id": "K_pasta",
   "type": "established",
   "nature": "fact",
   "text": "April 2026, Irvine, California: police say a 28-year-old man bought LEGO sets at Target stores, removed the pieces, filled the boxes with dried pasta and returned them for refunds. Narration: 'The strangest one bought sets and returned the boxes.' / 'The bricks? Replaced with dried pasta.'",
