  "claims": [
    {
      "id": "C1",
      "type": "illustrative",
      "text": "The story and characters are fiction. They dramatise a pattern; they do not prove anything.",
      "sources": []
    },
    {
      "id": "C2",
      "type": "plausible",
      "text": "Groups can agree to an action most members privately oppose because each assumes the others want it (Harvey's 'Abilene paradox', a management essay rather than an experiment).",
      "sources": [
        "S1",
        "S2"
      ]
    },
    {
      "id": "C3",
      "type": "established",
      "text": "People often misjudge what their peers privately think, believing they are alone in their discomfort (pluralistic ignorance), shown in survey studies such as Prentice & Miller (1993).",
      "sources": [
        "S3",
        "S4"
      ]
    }
  ],
