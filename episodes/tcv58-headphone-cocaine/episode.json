 "claims": [
  {
   "id": "H_hook",
   "type": "established",
   "nature": "fact",
   "text": "Cassie Sainsbury, an Australian (Adelaide) personal trainer, had about 5.8 kg of cocaine hidden in 18 headphone boxes / packages in her suitcase (Colombian police; her family said 15 pairs of headphones). Narration: 'An Australian trainer packed 18 headphone boxes.' (she pleaded guilty to trafficking).",
   "sources": [
    "ind_mule",
    "bordermail",
    "pedestrian",
    "buzzfeed",
    "ct_hk",
    "inq_ap"
   ]
  },
  {
   "id": "H_xray",
   "type": "established",
   "nature": "fact",
   "text": "An X-ray machine at Bogota's El Dorado airport detected the cocaine in her luggage as she was about to board. Narration: 'The airport X-ray saw what was inside.'",
   "sources": [
    "bordermail",
    "buzzfeed",
    "inq_ap",
    "ind_mule"
   ]
  },
  {
   "id": "H_who",
   "type": "established",
   "nature": "fact",
   "text": "She was 22 and from Adelaide, described as a (former) personal trainer. Narration: 'Cassie Sainsbury, 22, was a personal trainer from Adelaide.'",
   "sources": [
    "pedestrian",
    "buzzfeed",
    "illawarra",
    "inq_ap",
    "ind_mule"
   ]
  },
  {
   "id": "H_bogota",
   "type": "established",
   "nature": "fact",
   "text": "She was detained at El Dorado airport, Bogota, in April 2017 (11 or 12 April; reports differ) while about to board a flight to London (AP). Narration: 'In April 2017, she tried to fly out of Bogota.'",
   "sources": [
    "inq_ap",
    "ind_mule",
    "tnd_apr",
    "bordermail"
   ]
  },
  {
   "id": "H_dea",
   "type": "established",
   "nature": "reported",
   "text": "REPORTED (Colombian police): the U.S. Drug Enforcement Administration alerted Colombian police; her photo and passport details were reportedly forwarded as early as 5 April; her ticket had been bought in Hong Kong. Narration: 'But American agents had already flagged her.'",
   "sources": [
    "ind_tip",
    "tnd_tip",
    "ct_hk",
    "ind_mule"
   ]
  },
  {
   "id": "H_bricks",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): police said 5.8 kg (5,800 g) of cocaine in 18 packages in headphone boxes (AP: 'about 6 kilograms'). Narration: 'Inside the boxes: 5.8 kilos of cocaine.'",
   "sources": [
    "ind_mule",
    "bordermail",
    "pedestrian",
    "buzzfeed",
    "ct_hk",
    "sbs_sent"
   ]
  },
  {
   "id": "H_gifts",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: she told police she had bought the headphones to bring back to Australia for her wedding (AP); her family said they were gifts for her bridal party. Narration: 'She told police they were gifts for her wedding.'",
   "sources": [
    "inq_ap",
    "ind_mule",
    "newshub",
    "bordermail"
   ]
  },
  {
   "id": "H_claim",
   "type": "established",
   "nature": "reported",
   "text": "HER CLAIM (attributed): she told the court she agreed to carry the drugs only after her family was threatened; the first plea deal was thrown out in mid-2017 over it; the judge later weighed the claim. Narration: 'Then she claimed her family had been threatened.'",
   "sources": [
    "tnd_doubt",
    "bmg_plea",
    "ind_sent",
    "inq_ap"
   ]
  },
  {
   "id": "H_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (practical, for the viewer): Smartraveller: do not transport anything on behalf of another person, know what is in your bags, do not use bags that are not yours; UK FCDO: always pack your own luggage, do not carry anything through customs for someone else; recruiters promise free travel, easy money or 'low-risk opportunities'. Rows: 'CARRY NOTHING FOR OTHERS', 'PACK YOUR OWN BAG', 'FREE TRIP + EASY CASH = NO'.",
   "sources": [
    "smart_drugs",
    "smart_laws",
    "fcdo_news",
    "fcdo_kit"
   ]
  },
  {
   "id": "H_plea",
   "type": "established",
   "nature": "fact",
   "text": "She pleaded guilty to drug trafficking under a plea deal accepted by a Bogota judge on 2 November 2017. Narration: 'She pleaded guilty and took a plea deal.'",
   "sources": [
    "inq_ap",
    "sbs_sent",
    "ind_sent",
    "tnd_sent",
    "armidale",
    "bmg_plea"
   ]
  },
  {
   "id": "H_sentence",
   "type": "established",
   "nature": "fact",
   "text": "Sentence: six years in prison plus a US$90,000 fine (AP: nearly $100,000), 2 November 2017. Narration: 'Her wedding gifts ended up costing her six years.' (her 'wedding' account, ironic; the six years is the sentence).",
   "sources": [
    "inq_ap",
    "sbs_sent",
    "ind_sent",
    "tnd_sent",
    "armidale"
   ]
  },
  {
   "id": "H_after",
   "type": "established",
   "nature": "fact",
   "text": "CARD: she was freed on parole from El Buen Pastor women's prison in April 2020 under Colombia's COVID-19 humanitarian release, after about three years; she had to remain in Colombia for a further 27 months (Nine News, via AAP).",
   "sources": [
    "abc_free",
    "ind_free",
    "tnd_free",
    "illawarra"
   ]
  }
 ],
