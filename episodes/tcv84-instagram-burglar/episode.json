 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "Police say a 41-year-old Scottsdale man met wealthy people through the Scottsdale hospitality social scene, followed their accounts (court records via FOX 10: on Instagram; AZFamily: 'his social media feed') and targeted their homes. Narration: 'He robbed his own Instagram friends.' Headline 'HE ROBBED HIS OWN / INSTAGRAM FRIENDS'. Accused only.",
   "sources": [
    "fox10",
    "fox10b",
    "azfamily",
    "kold",
    "yourvalley"
   ]
  },
  {
   "id": "K_posts",
   "type": "established",
   "nature": "fact",
   "text": "Court records say that when the homeowners posted that they were travelling out of state or abroad, he used those posts to confirm the houses were empty before breaking in. Narration: 'Police say their vacation posts flagged empty homes.'",
   "sources": [
    "fox10",
    "azfamily",
    "kold",
    "yourvalley"
   ]
  },
  {
   "id": "K_tracked",
   "type": "established",
   "nature": "fact",
   "text": "He was arrested early on a Sunday in October 2026 (FOX 10: 4 October) shortly after a break-in at a central Phoenix home, after a multi-agency investigation tracked him to his office (FOX 10 places the office in Tempe, AZFamily in Scottsdale; narration says only 'his own office'). Narration: 'Then police tracked him. To his own office.'",
   "sources": [
    "fox10",
    "azfamily",
    "kold"
   ]
  },
  {
   "id": "K_dozen",
   "type": "established",
   "nature": "fact",
   "text": "Police suspect him in more than a dozen residential burglaries (FOX 10: 'a dozen to more than 20') across Scottsdale, Paradise Valley, Phoenix, Gilbert and Mesa. Narration: 'Suspected in at least a dozen homes.' Counter 12+ HOMES. Accused only; AS OF OCT 2026.",
   "sources": [
    "fox10",
    "azfamily",
    "kold",
    "yourvalley"
   ]
  },
  {
   "id": "K_power",
   "type": "established",
   "nature": "fact",
   "text": "Court records and the Scottsdale Police release say that in several cases he disabled the power to the home (the main breaker box) before forcing entry, shutting off security cameras. Narration: 'Police say he cut their power first.'",
   "sources": [
    "fox10",
    "yourvalley",
    "azfamily"
   ]
  },
  {
   "id": "K_parker",
   "type": "established",
   "nature": "fact",
   "text": "28 August 2009, Martinsburg, West Virginia: a burglar entered through a bedroom window, took two diamond rings worth more than $3,500, checked his Facebook account on the victim's home computer and left it logged in; the victim found the account open. Narration: 'A 2009 burglar checked Facebook on the victim's computer.' / 'He left it logged in.'",
   "sources": [
    "pcworld",
    "aol",
    "turley",
    "welive",
    "itwire"
   ]
  },
  {
   "id": "K_charged",
   "type": "established",
   "nature": "fact",
   "text": "A 19-year-old Pennsylvania man was charged with one count of felony daytime burglary and held on $10,000 bail; no verdict was found in the sources, so the reel says 'charged'. Label 'CHARGED · FELONY BURGLARY · 2009'.",
   "sources": [
    "pcworld",
    "aol",
    "turley",
    "welive"
   ]
  },
  {
   "id": "K_fact",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: a 2011 survey for the UK security firm Friedland of 50 former burglars found 78 % said social media such as Facebook, Twitter and Foursquare is used to select targets. Card: '4 IN 5 EX-BURGLARS SAID / THIEVES PICK TARGETS / ON SOCIAL MEDIA' with the survey named.",
   "sources": [
    "adweek",
    "time",
    "ubergizmo"
   ]
  },
  {
   "id": "K_knight",
   "type": "established",
   "nature": "fact",
   "text": "December 2010, Washington, DC: a burglar took cash, a coat and laptops from a Washington Post editor's home, photographed himself wearing the coat and holding the cash, and posted the photo to the victim's teenage son's Facebook account. Narration: 'The strangest took a selfie with the cash.' / 'And posted it on the victim's son's Facebook.'",
   "sources": [
    "nbcwash",
    "nbcnews",
    "newsone",
    "register",
    "cluley",
    "npr"
   ]
  },
  {
   "id": "K_plea",
   "type": "established",
   "nature": "fact",
   "text": "The 19-year-old pleaded guilty in February 2011 in DC Superior Court to second-degree burglary (and carrying a pistol without a licence, not mentioned) and was sentenced to 44 months. Narration: 'Guilty plea. Forty-four months.' Label 'PLEADED GUILTY · FEB 2011 · 44 MONTHS'.",
   "sources": [
    "nbcnews",
    "newsone",
    "findlaw",
    "cluley"
   ]
  }
 ],
