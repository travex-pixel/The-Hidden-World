 "claims": [
  {
   "id": "H_value",
   "type": "established",
   "nature": "fact",
   "text": "Over several months in 2011-2012 thieves stole maple syrup valued at about C$18.7 million (Wikipedia, CJAD; CBC, Mental Floss, CP24: about $18 million). Narration: 'They stole 18 million dollars of syrup.' (Canadian dollars; the headline card says $18M.)",
   "sources": [
    "wiki",
    "cjad",
    "mfloss",
    "cp24",
    "tce"
   ]
  },
  {
   "id": "H_water",
   "type": "established",
   "nature": "fact",
   "text": "Emptied barrels were refilled with water so the stock still looked full. Narration: 'And the barrels still looked full.' / 'added water, and brought them back.' Headline: 'SWAPPED FOR WATER'.",
   "sources": [
    "wiki",
    "mfloss",
    "star",
    "cjad"
   ]
  },
  {
   "id": "H_where",
   "type": "established",
   "nature": "fact",
   "text": "The syrup was the Federation of Quebec Maple Syrup Producers' reserve, stored in a rented warehouse in Saint-Louis-de-Blandford, Quebec (on a label; the town is not spoken).",
   "sources": [
    "wiki",
    "bloomberg",
    "mfloss",
    "tce"
   ]
  },
  {
   "id": "H_reserve",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: Quebec's producers' federation keeps a strategic reserve of maple syrup (the 'Global Strategic Maple Syrup Reserve') to keep supply and prices stable. Narration: 'It was Quebec's strategic reserve of syrup.'",
   "sources": [
    "bloomberg",
    "mfloss",
    "wiki",
    "cbc_guilty"
   ]
  },
  {
   "id": "H_night",
   "type": "established",
   "nature": "fact",
   "text": "Barrels were taken out at night (Toronto Star: over about ten months) and trucked away. Narration: 'Slowly, at night, for almost a year.'",
   "sources": [
    "star",
    "wiki",
    "tce"
   ]
  },
  {
   "id": "H_span",
   "type": "established",
   "nature": "fact",
   "text": "Police dated the theft from about August 2011 to July 2012 (just under a year). Progress chip: AUG 2011 -> JULY 2012 -> 2017.",
   "sources": [
    "mfloss",
    "wiki",
    "cnn"
   ]
  },
  {
   "id": "H_shack",
   "type": "established",
   "nature": "fact",
   "text": "The barrels were taken to a sugar shack, emptied and refilled with (stream/lake) water, then returned to the warehouse; later the syrup was drained on site. Narration: 'They emptied barrels at a sugar shack, added water, and brought them back.'",
   "sources": [
    "wiki",
    "star",
    "tce"
   ]
  },
  {
   "id": "H_found",
   "type": "established",
   "nature": "fact",
   "text": "On 30 July 2012 an inventory audit of the reserve began (Bloomberg; Wikipedia: July 2012); the inspector, climbing the stacked barrels, nearly fell. Narration: 'In 2012, an inspector climbed up the barrels.' (He is not named or depicted as a likeness.)",
   "sources": [
    "bloomberg",
    "mfloss",
    "wiki"
   ]
  },
  {
   "id": "H_empty",
   "type": "established",
   "nature": "fact",
   "text": "The barrel was empty (Mental Floss: the barrel he climbed onto nearly tipped over; it was empty. Wikipedia: he expected 600-lb barrels and found them empty); many others that looked full held water. Narration: 'And the barrel under him? Empty.'",
   "sources": [
    "mfloss",
    "wiki",
    "cbc_guilty"
   ]
  },
  {
   "id": "H_barrels",
   "type": "established",
   "nature": "fact",
   "text": "About 9,600 barrels were emptied (CBC: 9,571; Guardian via student press: over 9,500; CNN/others: 9,600; law newsletter: about 10,000). Label: 'NEARLY 10,000 BARRELS EMPTIED'.",
   "sources": [
    "cbc_guilty",
    "cnn",
    "wiki"
   ]
  },
  {
   "id": "H_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): Canada produced more than 75 % of the world's maple syrup in 2025 (73 % in 2024), with 90.0 % of Canadian production from Quebec (Agriculture and Agri-Food Canada 2025 overview; Statistics Canada 2025). Narration: 'Canada makes over three quarters of the world's syrup.' Counter 'OVER 75%'.",
   "sources": [
    "aafc25",
    "aafc24",
    "statcan"
   ]
  },
  {
   "id": "H_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (police guidance on not buying stolen goods online): a price far below normal (ACT Policing; Winnipeg Police), no receipt / proof of purchase or serial number (Winnipeg Police Service), and a seller who wants to meet somewhere you are not comfortable (Winnipeg Police; ACT Policing advises a busy, well-lit public place). Buying stolen property can mean it is seized without refund. Rows: 'WAY BELOW MARKET PRICE', 'NO RECEIPT OR SERIAL NO.', 'WON'T MEET IN PUBLIC'.",
   "sources": [
    "wps_ctv",
    "wps_chvn",
    "act_scoot",
    "act_vig"
   ]
  },
  {
   "id": "H_sentence",
   "type": "established",
   "nature": "fact",
   "text": "Richard Vallieres, described as a ringleader, was found guilty of theft, fraud and trafficking (2016) and in 2017 sentenced to eight years in prison. Narration: 'Then the ringleader got eight years.'",
   "sources": [
    "cbc_sent",
    "ctv_sent",
    "reuters_scc",
    "wiki"
   ]
  },
  {
   "id": "H_fine",
   "type": "established",
   "nature": "fact",
   "text": "He was also fined about C$9.4 million (2017); the Quebec Court of Appeal cut it to about C$1 million; on 31 March 2022 the Supreme Court of Canada restored a fine of about C$9.17 million ($10M less $828,602 restitution), with 10 years to pay or six more years in prison. Narration: 'And a fine of over 9 million dollars.'",
   "sources": [
    "cbc_sent",
    "scc",
    "cbc_scc",
    "reuters_scc",
    "wiki"
   ]
  }
 ],
