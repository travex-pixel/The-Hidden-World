 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "In March 2019 the Ministry of Justice said dead rats stuffed with drugs and phones had been thrown over the perimeter fence of HMP Guys Marsh, Dorset, England, for an inmate to collect. Narration: 'Dead rats full of drugs flew into a prison.' Headline 'DEAD RATS FULL OF DRUGS / THROWN INTO A PRISON'.",
   "sources": [
    "cnn",
    "itv",
    "cbs",
    "scotsman",
    "guernsey",
    "fox"
   ]
  },
  {
   "id": "K_stitch",
   "type": "established",
   "nature": "fact",
   "text": "The rats had been stitched up along their stomachs (staff noticed the stitching and opened them). Narration: 'With stitches. Like teddy bears.' (the teddy-bear comparison is our own joke, not a source's).",
   "sources": [
    "cnn",
    "itv",
    "cbs",
    "scotsman"
   ]
  },
  {
   "id": "K_first",
   "type": "established",
   "nature": "fact",
   "text": "The Ministry of Justice said rats were a new method; pigeons and tennis balls had been used before. Narration: 'But rats were not the first trick.'",
   "sources": [
    "cnn",
    "itv",
    "scotsman",
    "cbs"
   ]
  },
  {
   "id": "K_balls",
   "type": "established",
   "nature": "fact",
   "text": "Tennis balls packed with drugs and mobile phones have been thrown over prison walls and fences (HMP Doncaster and HMP Dovegate, England; Lakeland Correctional Facility, Michigan). Narration: 'First, tennis balls stuffed with drugs and phones.' Label 'THROWN OVER THE WALL / English and American prisons'.",
   "sources": [
    "doncaster",
    "star",
    "lakeland",
    "cnn"
   ]
  },
  {
   "id": "K_wild",
   "type": "established",
   "nature": "fact",
   "text": "Editorial bridge to item 2. Narration: 'Still not the wildest one.'",
   "sources": [
    "cnn",
    "itv"
   ]
  },
  {
   "id": "K_drone",
   "type": "established",
   "nature": "fact",
   "text": "Drones are used to fly drugs and other contraband over prison walls in England and Wales (Ministry of Justice). Narration: 'Next, drones flying drugs over the walls.'",
   "sources": [
    "gov_drones",
    "gov_nfz",
    "ch4",
    "uas"
   ]
  },
  {
   "id": "K_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): 1,712 drone incidents at prisons in England and Wales between April 2024 and March 2025, up 43 % on the previous 12 months (HMPPS Annual Digest, published 31 July 2025). Narration: 'That is 1,712 drone incidents in one year.' (the place is on the label)",
   "sources": [
    "gov_drones",
    "uas",
    "ch4",
    "sj"
   ]
  },
  {
   "id": "K_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (practical, for the viewer): recreational drone flyers in the U.S. fly at or below 400 ft in uncontrolled airspace and keep the drone within visual line of sight (FAA); the UK Drone Code: never above 120 m (400 ft), always keep it in sight (CAA); flying within 400 m of a closed prison or young offender institution in England and Wales is an offence since 25 January 2024 (fines up to 2,500 pounds). Rows: 'STAY UNDER 400 FT (120 M)', 'KEEP IT IN YOUR SIGHT', 'PRISONS: 400 M NO-FLY (UK)'.",
   "sources": [
    "faa",
    "caa",
    "gov_nfz",
    "gov_nfz2",
    "gulf"
   ]
  },
  {
   "id": "K_rats",
   "type": "established",
   "nature": "fact",
   "text": "Staff found three dead rats just inside the perimeter fence of HMP Guys Marsh; the ministry said they had been thrown over the fence. Narration: 'Then came the rats, thrown over the fence.' Label 'HMP GUYS MARSH · DORSET, ENGLAND · 2019'.",
   "sources": [
    "cnn",
    "itv",
    "cbs",
    "scotsman",
    "guernsey",
    "fox"
   ]
  },
  {
   "id": "K_inside",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: inside the three rats: five mobile phones with chargers, three SIM cards, cigarette papers and drugs (Spice and cannabis). Narration: 'Inside were five phones, chargers and drugs.'",
   "sources": [
    "cnn",
    "itv",
    "scotsman",
    "guernsey",
    "fox"
   ]
  },
  {
