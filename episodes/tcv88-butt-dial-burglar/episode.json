 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "Fresno, California, May 2013: police say two 20-year-old men dialled 911 by accident from a cell phone while on their way to break into a car; the dispatcher heard the whole thing. Narration: 'Police say burglars butt-dialed 911.' Headline 'BURGLARS BUTT-DIALED / 911 MID-BREAK-IN'. Charged only: never named, silhouettes.",
   "sources": [
    "abc",
    "findlaw",
    "policemag",
    "apco",
    "cpost",
    "ems1"
   ]
  },
  {
   "id": "K_line",
   "type": "established",
   "nature": "fact",
   "text": "The call went unanswered by the men; the dispatcher did not hang up and stayed on the line listening to a rambling conversation that moved from looking for drugs to breaking into a vehicle. Narration: 'Mid break-in, nobody hung up.'",
   "sources": [
    "abc",
    "findlaw",
    "policemag",
    "cpost"
   ]
  },
  {
   "id": "K_smash",
   "type": "established",
   "nature": "fact",
   "text": "The dispatcher heard a car window break (and the men shout that they had found prescription drugs), picked up clues about where they were heading and passed them to officers, who tracked the men down and pulled them over. Narration: 'The operator heard the window smash, and sent officers.' ('operator' is AP's word.)",
   "sources": [
    "abc",
    "findlaw",
    "policemag",
    "apco",
    "cpost"
   ]
  },
  {
   "id": "K_charged",
   "type": "established",
   "nature": "fact",
   "text": "Both men were arrested on 9 May 2013 for investigation of burglary, conspiracy to commit a crime and possession of stolen property; items allegedly taken from the car were found. No plea, trial or sentence was found in any source, so the reel says charged/accused only. Label 'BOTH CHARGED · BURGLARY, CONSPIRACY · MAY 2013'. AS OF OCT 2026.",
   "sources": [
    "abc",
    "findlaw",
    "policemag",
    "ems1"
   ]
  },
  {
   "id": "K_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter 30 %): in a 2015 study with San Francisco's emergency dispatch centre, Google researchers found about 30 % of the mobile 911 calls received during the sampled window were accidental. Counter '30%' with the label 'MOBILE 911 CALLS · ACCIDENTAL' and the study named.",
   "sources": [
    "nbcgoogle",
    "ems1b",
    "police1",
    "wtvr"
   ]
  },
  {
   "id": "K_plug",
   "type": "established",
   "nature": "fact",
   "text": "Silver Spring, Maryland, late January 2011: a burglar plugged his cell phone in to charge inside the home he was burgling; police say his own home had lost power in a snowstorm. Narration: 'A burglar charged his phone mid-burglary.' Label 'SILVER SPRING, MARYLAND · JAN 2011'.",
   "sources": [
    "nbcwash",
    "cbs",
    "nbcnews",
    "foxnews",
    "patch"
   ]
  },
  {
   "id": "K_fled",
   "type": "established",
   "nature": "fact",
   "text": "The homeowner's son arrived and surprised him; he jumped out of a window and fled, leaving the phone charging in the socket, where police found it. Narration: 'He fled. The phone was still charging.' Callout 'STILL CHARGING'.",
   "sources": [
    "nbcwash",
    "cbs",
    "nbcnews",
    "foxnews"
   ]
  },
  {
   "id": "K_years",
   "type": "established",
   "nature": "fact",
   "text": "Police called one of the contacts in the phone to learn the owner's name and arrested the 25-year-old the same day; he admitted seven break-ins and was sentenced in July 2011 in Montgomery County to more than 26 years in prison. Narration: 'Police rang his contacts. 26 years.' Label '26 YEARS · ADMITTED SEVEN BREAK-INS · JULY 2011'.",
   "sources": [
    "nbcwash",
    "cbs",
    "upi",
    "nbcwash2"
   ]
  },
  {
   "id": "K_fact",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: in 2014 FCC Commissioner Michael O'Rielly estimated, from dispatchers' accounts, that about half of mobile 911 calls are accidental, which would be roughly 84 million butt-dials a year in the US. Card: 'AN FCC COMMISSIONER'S ESTIMATE: / 84 MILLION BUTT-DIALS / TO 911 EVERY YEAR', attributed as an estimate.",
   "sources": [
    "hothardware",
    "fox61",
    "wtvr"
   ]
  },
  {
   "id": "K_left",
   "type": "established",
   "nature": "fact",
   "text": "Walnut Creek, California (reports undated): police say a man caught on video breaking into a restaurant left his cell phone inside; the phone gave officers his identity, which matched the man on the video. Narration: 'Police say the strangest left his phone behind.' Accused only.",
   "sources": [
    "ktvu",
    "cbssf"
   ]
  },
  {
   "id": "K_station",
   "type": "established",
   "nature": "fact",
   "text": "Officers arrested him for burglary when he came to the Walnut Creek police department to retrieve the phone; he was taken to the county jail in Martinez. No court outcome found. Narration: 'Then asked the police for it back. Arrested.' Label 'ARRESTED AT THE STATION · POLICE SAY'.",
   "sources": [
    "ktvu",
    "cbssf"
   ]
  },
  {
   "id": "K_minutes",
   "type": "established",
   "nature": "fact",
   "text": "The accidental Fresno 911 call ran about 35 minutes (KXTV via ABC News/AP: 'a rambling 35-minute conversation'). Narration: 'That butt-dial lasted 35 minutes.'",
   "sources": [
    "abc",
    "findlaw",
    "policemag",
    "cpost"
   ]
  }
 ],
