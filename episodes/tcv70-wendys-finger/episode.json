 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "On 22 March 2005 Anna Ayala claimed she found a human fingertip in a bowl of chili at a Wendy's in San Jose, California; police called it a hoax and she pleaded guilty (September 2005) with her husband to conspiracy to file a false claim and attempted grand theft. Narration: 'A finger in her Wendy's chili? She put it there.' Headline 'A FINGER IN WENDY'S CHILI / SHE PUT IT THERE'.",
   "sources": [
    "wiki",
    "nbc_hands",
    "deseret",
    "ljw",
    "fox",
    "upi"
   ]
  },
  {
   "id": "K_whose",
   "type": "established",
   "nature": "fact",
   "text": "Open loop answered in s05, with the reward: Wendy's offered a $100,000 reward for information on where the finger came from. Narration: 'Whose finger? A $100,000 question.'",
   "sources": [
    "nbc_tip",
    "deseret",
    "fox"
   ]
  },
  {
   "id": "K_claim",
   "type": "established",
   "nature": "fact",
   "text": "Ayala said she bit into the fingertip while eating the chili at the San Jose restaurant (March 2005). Narration: 'In San Jose, she said she bit into it.' Label 'SAN JOSE, CALIFORNIA · MARCH 22, 2005'.",
   "sources": [
    "fox",
    "wiki",
    "nbc_hands",
    "abc"
   ]
  },
  {
   "id": "K_cooked",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: the Santa Clara County coroner's office said the finger was inconsistent with having been cooked in chili at about 170 F for three hours; reports say there was no evidence it had been cooked. Narration: 'But it was never even cooked.' Card 'CHILI SIMMERS 3 HRS AT 170°F / THE FINGER WAS NOT COOKED'.",
   "sources": [
    "ljw",
    "wiki",
    "aetv",
    "abc"
   ]
  },
  {
   "id": "K_jobs",
   "type": "established",
   "nature": "fact",
   "text": "Sales at the area's Wendy's restaurants fell after the claim, and workers were laid off or had hours cut; the court later ordered about $170,000 for employees' lost wages. Narration: 'It gets worse. Workers lost their jobs.'",
   "sources": [
    "deseret",
    "nbc_hands",
    "upi",
    "npr"
   ]
  },
  {
   "id": "K_loss",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): the felony complaint put the loss to Wendy's in the area at $2.5 million (Wendy's also offered a $100,000 reward). Narration: 'The charges put the loss at $2.5 million.' Counter '$2,500,000 / LOSS, PER THE CHARGES'.",
   "sources": [
    "deseret",
    "nbc_tip",
    "fox",
    "qsr"
   ]
  },
  {
   "id": "K_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (official, for the viewer): to have a foreign object in food investigated, keep the object, the original packaging and any uneaten food (refrigerate or freeze it), note the store and purchase date, and report it (USDA FSIS Meat and Poultry Hotline / electronic complaint form; FDA; UK Food Standards Agency 'Report a food problem'). Rows 'KEEP OBJECT + PACKAGING', 'FREEZE WHAT IS LEFT', 'REPORT IT TO A REGULATOR'.",
   "sources": [
    "fsis",
    "fsis_ecc",
    "fda",
    "fsa"
   ]
  },
  {
   "id": "K_finger",
   "type": "established",
   "nature": "fact",
   "text": "The fingertip came from a co-worker of Ayala's husband, Jaime Plascencia (the co-worker was not charged; not named here). Narration: 'The answer? Her husband's co-worker's.'",
   "sources": [
    "fox",
    "aj",
    "justfood",
    "nbc_husb",
    "cbs"
   ]
  },
  {
   "id": "K_tailgate",
   "type": "established",
   "nature": "fact",
   "text": "The co-worker lost the fingertip in an industrial accident in December 2004: a truck's tailgate at the Las Vegas asphalt/paving company where they worked. Narration: 'He lost it in a truck tailgate at work.' Label 'LAS VEGAS · DECEMBER 2004 / An accident at work, police said'.",
   "sources": [
    "snopes",
    "lv3",
    "justfood",
    "rutland",
    "fox"
   ]
  },
  {
   "id": "K_paid",
   "type": "established",
   "nature": "fact",
   "text": "According to court documents, Plascencia paid the co-worker $100 for the fingertip. Narration: 'Her husband bought it for $100.' Label 'PAID FOR THE FINGERTIP: $100 / Court papers, as reported by AP'.",
   "sources": [
    "fox",
    "deseret",
    "rutland",
    "aj"
   ]
  },
  {
   "id": "K_share",
   "type": "established",
   "nature": "editorial",
   "text": "Share prompt (editorial). Narration: 'Send this to the mate who never finishes his food.'",
   "sources": [
    "fox",
    "upi"
   ]
  },
  {
   "id": "K_lab",
   "type": "established",
   "nature": "fact",
   "text": "Police identified the fingertip's source in May 2005 (announced 13 May 2005). Shown only as a generic evidence bag with a blurred object; label 'SOURCE TRACED · MAY 2005'.",
   "sources": [
    "wiki",
    "nbc_husb",
    "cbs",
    "justfood"
   ]
  },
  {
   "id": "K_sentence",
   "type": "established",
   "nature": "fact",
   "text": "On 18 January 2006 in Santa Clara County, Judge Edward Davila sentenced Ayala to nine years and Plascencia to 12 years and 4 months; both had pleaded guilty. Narration (last line): 'The fingertip cost $100. She got nine years.' Label 'SENTENCED · JANUARY 2006 / Ayala 9 years · husband 12 years 4 months'.",
   "sources": [
    "upi",
    "aj",
    "fox",
    "wiki",
    "abc"
   ]
  }
 ],
