 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "A cross-border drug-smuggling tunnel ran from a former (vacant) KFC restaurant in San Luis, Arizona, about 200 yards north of the border, to a house in San Luis Rio Colorado, Sonora, Mexico (found August 2018). Narration: 'Smugglers hid a drug tunnel in a KFC.' Headline 'A DRUG TUNNEL / UNDER A KFC'.",
   "sources": [
    "ap_wt",
    "nbcnews",
    "foxnews",
    "fox10",
    "global"
   ]
  },
  {
   "id": "K_590",
   "type": "established",
   "nature": "fact",
   "text": "The tunnel was 22 feet deep and about 590 feet long, ending at a residence in San Luis Rio Colorado. Narration: 'It ran 590 feet to Mexico.' / '22 feet down. Right under the border.' Counter '590 FT'.",
   "sources": [
    "ap_nbcsd",
    "12news",
    "wtvr",
    "abc15",
    "ktar"
   ]
  },
  {
   "id": "K_carrots",
   "type": "established",
   "nature": "fact",
   "text": "January 2016, Pharr International Bridge, Texas: CBP officers found 2,817 carrot-shaped packages of marijuana (about 2,493 lb, about $499,000) mixed into a commercial shipment of carrots. Narration: 'But first, a truck full of carrots.' / 'Nearly 3,000 were fake. Stuffed with weed.' Label 'PHARR, TEXAS · JAN 2016'.",
   "sources": [
    "nbcdfw",
    "cbs16",
    "fox13",
    "anuk"
   ]
  },
  {
   "id": "K_drone",
   "type": "established",
   "nature": "fact",
   "text": "Night of 20 January 2015, Tijuana, near the San Ysidro crossing: a six-rotor drone carried more than six pounds (about 3 kg) of methamphetamine in six taped packets. Narration: 'But that was not their wildest one.' (editorial rehook) / 'A drone carried six pounds of meth.'",
   "sources": [
    "ap_pbs",
    "ap_csm",
    "foxdrone",
    "tnw"
   ]
  },
  {
   "id": "K_crash",
   "type": "established",
   "nature": "fact",
   "text": "Police said the drone could not withstand the weight of its load and crashed in a supermarket parking lot. Narration: 'Too heavy. It crashed in a supermarket parking lot.'",
   "sources": [
    "ap_pbs",
    "ap_csm",
    "foxdrone",
    "tnw"
   ]
  },
  {
   "id": "K_stop",
   "type": "established",
   "nature": "fact",
   "text": "On 13 August 2018 San Luis police stopped the building's owner (a vehicle violation); a K-9 alerted to two toolboxes in the truck holding methamphetamine, cocaine, heroin and fentanyl. He was arrested and held without bond; no plea or sentence was found, so he is not named. Narration: 'Then police stopped an old KFC's owner.' Label 'HIS TOOLBOXES: METH, HEROIN, FENTANYL'.",
   "sources": [
    "abc15",
    "foxnews",
    "ap_wt",
    "12news"
   ]
  },
  {
   "id": "K_kitchen",
   "type": "established",
   "nature": "fact",
   "text": "Agents with search warrants found the tunnel's entrance in the kitchen of the former restaurant. Narration: 'Under the kitchen floor? A tunnel.'",
   "sources": [
    "12news",
    "abc15",
    "wtvr",
    "foxnews"
   ]
  },
  {
   "id": "K_bed",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: at the Mexican end the tunnel came up through a trap door under a bed in the house. Narration: 'The other end? Found under a bed.'",
   "sources": [
    "ap_nbcsd",
    "12news",
    "abc15"
   ]
  },
  {
   "id": "K_punch",
   "type": "established",
   "nature": "fact",
   "text": "The restaurant was closed/vacant; authorities said the tunnel was used to smuggle drugs. Narration (the closing line, wordplay on those facts): 'The kitchen was closed. The tunnel was not.'",
   "sources": [
    "fox10",
    "nbcnews",
    "global",
    "ap_wt"
   ]
  },
  {
   "id": "K_part4",
   "type": "established",
   "nature": "fact",
   "text": "PART 4 TEASE (end card): 22 July 2023, near Calexico, Mexican authorities, alerted by Border Patrol agents who saw the fence being cut, found a white truck cloned to look like a U.S. Border Patrol vehicle and 17 migrants. End card 'PART 4: A FAKE BORDER PATROL TRUCK'.",
   "sources": [
    "wt23",
    "kold",
    "fox23"
   ]
  }
 ],
