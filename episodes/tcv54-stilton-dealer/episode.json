 "claims": [
  {
   "id": "J_hook",
   "type": "established",
   "nature": "fact",
   "text": "Carl Stewart, 39, of Liverpool was identified from a photo he shared on EncroChat of a block of Stilton in his hand, and was sentenced to 13 years and six months. Narration: 'A photo of cheese got him 13 years.' (the photo identified him; the sentence was for the drug conspiracies; '13' rounds down 13 years 6 months; the last line gives the full term).",
   "sources": [
    "ap_rep",
    "cbs",
    "register",
    "fox",
    "kcrg",
    "abc6"
   ]
  },
  {
   "id": "J_noface",
   "type": "established",
   "nature": "fact",
   "text": "Merseyside Police: the photo did not show any facial features; analysts identified him from the palm and fingerprints. Narration: 'His face was not even in it.'",
   "sources": [
    "pedestrian",
    "irishlegal",
    "cbs",
    "fox"
   ]
  },
  {
   "id": "J_dealer",
   "type": "established",
   "nature": "fact",
   "text": "He pleaded guilty to conspiracy to supply cocaine, conspiracy to supply heroin, MDMA and ketamine, and transferring criminal property; DI Lee Wilkinson said he was involved in supplying large amounts of Class A and B drugs. Narration: 'He was a Liverpool drug dealer.'",
   "sources": [
    "cbs",
    "ap_rep",
    "register",
    "fox",
    "mentalfloss"
   ]
  },
  {
   "id": "J_encro",
   "type": "established",
   "nature": "fact",
   "text": "He used EncroChat, an encrypted phone network, under the handle 'Toffeeforce'. Narration: 'He used EncroChat, a secret phone network.'",
   "sources": [
    "cbs",
    "ap_rep",
    "pedestrian",
    "nca_2020"
   ]
  },
  {
   "id": "J_cracked",
   "type": "established",
   "nature": "fact",
   "text": "In April 2020 Eurojust set up a joint investigation team between France and the Netherlands (with Europol), which put 'a technical device' in place to get past EncroChat's encryption; the interception ended on 13 June 2020 when EncroChat realised it had been penetrated. Narration: 'But French and Dutch police had cracked it.'",
   "sources": [
    "eurojust",
    "govinfo",
    "secaff"
   ]
  },
  {
   "id": "J_venetic",
   "type": "established",
   "nature": "fact",
   "text": "The UK response was Operation Venetic, led by the National Crime Agency with police forces; the Stewart case came from it (Merseyside Police had arrested more than 60 people under it by May 2021). Card only.",
   "sources": [
    "nca_2020",
    "nca_venetic",
    "cbs",
    "pedestrian"
   ]
  },
  {
   "id": "J_stat",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC (counter): announcing the first results on 2 July 2020, the NCA said UK law enforcement had arrested 746 suspects and seized over £54 million in criminal cash, 77 firearms and over two tonnes of Class A and B drugs so far. Narration: 'The hack's first haul? Over fifty-four million in cash.'",
   "sources": [
    "nca_2020",
    "lbc",
    "express",
    "computing"
   ]
  },
  {
   "id": "J_toffee",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: his EncroChat handle was 'Toffeeforce', a nod / reference to Everton Football Club (nicknamed the Toffees). Narration: 'His username? Toffeeforce, after Everton.'",
   "sources": [
    "pedestrian",
    "kcrg",
    "cbs",
    "ap_rep"
   ]
  },
  {
   "id": "J_photo",
   "type": "established",
   "nature": "fact",
   "text": "He shared on EncroChat a photo of a block of Stilton cheese in his hand. Narration: 'He shared a photo of Stilton.'",
   "sources": [
    "ap_rep",
    "cbs",
    "register",
    "fox",
    "kcrg",
    "abc6"
   ]
  },
  {
   "id": "J_mands",
   "type": "established",
   "nature": "fact",
   "text": "Label: Merseyside Police said the Stilton was from Marks & Spencer (typed text only; no logo or packaging is drawn).",
   "sources": [
    "cbs",
    "fox",
    "mixmag"
   ]
  },
  {
   "id": "J_prints",
   "type": "established",
   "nature": "fact",
   "text": "Merseyside Police: his palm and fingerprints were analysed from the picture and it was established they belonged to Stewart. Narration: 'But look at the hand holding it. Then police matched his palm and fingerprints.'",
   "sources": [
    "cbs",
    "register",
    "fox",
    "irishlegal",
    "pedestrian"
   ]
  },
  {
   "id": "J_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (practical, for the viewer): what a posted photo can give away. (1) Fingerprints: Japan's National Institute of Informatics (Isao Echizen, Jan 2017) copied fingerprints from photos taken about 3 m away when the fingers were in focus and well lit. (2) Location: photo files can carry GPS coordinates (EXIF); the FBI warns that posted images can reveal a 'pattern of life', and the U.S. Army warns embedded photo data can tip off criminals. (3) Reflections: in 2019 a man in Tokyo found a singer's home from a station/bus stop reflected in her eyes in selfies (police account, widely reported). Rows: 'FINGERTIPS IN SHARP FOCUS', 'HIDDEN LOCATION DATA', 'REFLECTIONS IN YOUR EYES'.",
   "sources": [
    "nii_arab",
    "nii_malay",
    "nii_reuters",
    "fbi",
    "patch_fbi",
    "army",
    "eyes_cbs",
    "eyes_reg",
    "eyes_tnw"
   ]
  },
  {
   "id": "J_sentence",
   "type": "established",
   "nature": "fact",
   "text": "He was sentenced to 13 years and six months at Liverpool Crown Court (reported 24-30 May 2021). Narration: 'His sentence? Thirteen and a half years.'",
   "sources": [
    "ap_rep",
    "cbs",
    "register",
    "fox",
    "kcrg",
    "abc6",
    "irishlegal"
   ]
  },
  {
   "id": "J_caught",
   "type": "established",
   "nature": "fact",
   "text": "DI Lee Wilkinson (Merseyside Police) said Stewart was 'caught out by his love of Stilton cheese'. Narration: 'Brought down by one block of cheese.'",
   "sources": [
    "cbs",
    "ap_rep",
    "fox",
    "mentalfloss"
   ]
  }
 ],
