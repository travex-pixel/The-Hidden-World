 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "Kayseri, Turkey, about 4 a.m. on 9 February 2026 (Melikgazi district): a 26-year-old man took about 150 grams of gold from a jewellery shop and rode off through the empty town on a donkey; security cameras filmed the ride. Narration: 'His getaway vehicle? A donkey.' Headline 'GETAWAY VEHICLE: / A DONKEY'. Convicted at first instance (May 2026): never named (initials only in the Turkish press), a silhouette.",
   "sources": [
    "dha",
    "ntv",
    "ensonhaber",
    "birlik",
    "gulfnews",
    "ttoday",
    "telegraph"
   ]
  },
  {
   "id": "K_gold",
   "type": "established",
   "nature": "fact",
   "text": "The haul was about 150 grams of gold jewellery; the raid happened at about 04:00 (Turkish reports; one English report says 'early on February 9', another 'February 10'). Narration: 'Turkey. 150 grams of gold, four in the morning.' Label 'KAYSERI, TURKEY · 9 FEB 2026'.",
   "sources": [
    "dha",
    "ntv",
    "ensonhaber",
    "karar",
    "gulfnews",
    "ttoday"
   ]
  },
