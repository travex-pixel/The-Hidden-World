 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "About 2.7 tonnes of cocaine, Australia's largest cocaine seizure on record, was found on 19 June 2026 in plastic tubs buried in underground bunkers concealed by false floors in three shipping containers on a semi-rural property in Londonderry, western Sydney. Narration: 'Australia's record cocaine bust was buried.' / 'Under 3 shipping containers.' Headline 'AUSTRALIA'S COCAINE BUST / UNDER THE CONTAINERS'.",
   "sources": [
    "abf",
    "ap",
    "npr",
    "dailyaus"
   ]
  },
  {
   "id": "K_bananas",
   "type": "established",
   "nature": "fact",
   "text": "July 2026, port of Vado Ligure, Italy: police (Guardia di Finanza) found about 1,700 lb (770 kg) of cocaine in 650 packages hidden among pallets of bananas in a refrigerated container from Ecuador; estimated value about EUR 250 million (CBS: about $285-286 million). Narration: 'But first, Italy. Bananas from Ecuador.' / 'Among the bananas? 1,700 pounds of cocaine.'",
   "sources": [
    "cbsnews",
    "fox5ny",
    "ground"
   ]
  },
  {
   "id": "K_bus",
   "type": "established",
   "nature": "fact",
   "text": "22 September 2026 (announced 7 October 2026), San Ysidro port of entry: a commercial passenger bus driven by a Mexican national was referred after an imaging system detected anomalies in its gas tank and a canine team alerted. Narration: 'But that was not the sneakiest one.' (editorial rehook) / 'A bus pulled up to the American border.'",
   "sources": [
    "cbp",
    "hoodline",
    "patch"
   ]
  },
  {
   "id": "K_tank",
   "type": "established",
   "nature": "fact",
   "text": "CBP officers found a non-factory compartment in the bus's gas tank holding 110 packages, 262.21 lb of cocaine (about $5 million); the driver faces state prosecution (accused only, not named). Narration: 'Inside its fuel tank? 262 pounds of cocaine.' / 'Wrong kind of fuel.' (editorial joke).",
   "sources": [
    "cbp",
    "hoodline",
    "patch",
    "ggnorth"
   ]
  },
  {
   "id": "K_raid",
   "type": "established",
   "nature": "fact",
   "text": "AFP investigators executed a search warrant at a semi-rural property in Londonderry, about 60 km north-west of Sydney's centre (western Sydney), on Friday 19 June 2026. Narration: 'Then Sydney. Police raided a property out west.'",
   "sources": [
    "abf",
    "ap",
    "dailyaus"
   ]
  },
  {
   "id": "K_floor",
   "type": "established",
   "nature": "fact",
   "text": "In three shipping containers near the rear of the property, police found the cocaine in underground bunkers concealed by false container floors. Narration: 'The floors were fake. Below them? Bunkers.'",
   "sources": [
    "abf",
    "ap",
    "npr",
    "indaily"
   ]
  },
  {
   "id": "K_tonnes",
   "type": "established",
   "nature": "fact",
   "text": "STATISTIC: about 2.7 tonnes of cocaine in plastic tubs, the largest cocaine seizure in Australia's history (previous record 2.34 tonnes, 2024); street value about A$816 million. Narration: '2.7 tonnes of cocaine, in plastic tubs.' Counter '2.7 TONNES'.",
   "sources": [
    "abf",
    "ap",
    "npr",
    "dailyaus"
   ]
  },
  {
   "id": "K_deals",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: the AFP said the haul was equivalent to about three million street-level deals. Narration: 'Three million street deals, police said.'",
   "sources": [
    "dailyaus",
    "indaily",
    "ap"
   ]
  },
  {
   "id": "K_punch",
   "type": "established",
   "nature": "fact",
   "text": "Two men, aged 21 and 25, allegedly tried to flee on foot and were arrested; each is charged with possessing a commercial quantity of an unlawfully imported border-controlled drug (maximum life). Accused only; one was later granted bail; no plea or verdict found as of 18 Oct 2026. Narration: 'Two men were arrested. The containers were just the lid.' (the second sentence is wordplay on the false floors over the bunkers).",
   "sources": [
    "abf",
    "ap",
    "aap",
    "npr"
   ]
  },
  {
   "id": "K_part2",
   "type": "established",
   "nature": "fact",
   "text": "PART 2 TEASE (end card): Australia's previous record cocaine seizure was 2.34 tonnes, found in 2024 on a fishing boat near K'gari (Fraser Island), Queensland. End card 'PART 2: 2.3 TONNES ON A FISHING BOAT'.",
   "sources": [
    "ap",
    "npr"
   ]
  }
