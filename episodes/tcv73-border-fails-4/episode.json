 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "22 July 2023, near Calexico, California: Mexican authorities found a white pickup made to look like a U.S. Border Patrol vehicle ('cloned'; insignia/decals replicating CBP trucks), in a suspected smuggling attempt. Narration: 'Smugglers made a fake Border Patrol truck.' Headline 'A FAKE BORDER PATROL TRUCK / MADE BY SMUGGLERS'.",
   "sources": [
    "wt23",
    "kold",
    "fox23",
    "nn23"
   ]
  },
  {
   "id": "K_list",
   "type": "established",
   "nature": "editorial",
   "text": "Editorial framing: the Calexico truck is the third of three verified disguised-vehicle cases told in this episode. Narration: 'It is number 3 on this list.'",
   "sources": [
    "wt23",
    "kvia",
    "brk9"
   ]
  },
  {
   "id": "K_fedex",
   "type": "established",
   "nature": "fact",
   "text": "Friday 9 June 2023, west El Paso, Texas: Border Patrol agents (Santa Teresa Station Anti-Smuggling Unit) with Texas DPS stopped three vehicles, two of them made to look identical to white FedEx vans; 26 migrants were found and four suspected smugglers were arrested. Narration: 'First: two vans dressed as FedEx.' / 'Agents still stopped them. Four arrests.'",
   "sources": [
    "kvia",
    "ept",
    "brfedex",
    "vice"
   ]
  },
  {
   "id": "K_k9",
   "type": "established",
   "nature": "fact",
   "text": "8 January 2025: a white Ford F-150 customized to match a local Border Patrol K-9 unit picked up migrants at a breach in the border wall near Andrade, California (24 per Border Report and Just the News). Three men were indicted on 4 February 2025 (charged only; not named here). Narration: 'But the next fake was bolder.' (editorial rehook) / 'A cloned Border Patrol K-9 truck.'",
   "sources": [
    "brk9",
    "jtn",
    "yuma"
   ]
  },
  {
   "id": "K_plate",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: the truck matched the local federal K-9 unit 'down to the license plate number' (as reported from the case). Narration: 'It even copied a real unit's plate number.'",
   "sources": [
    "brk9",
    "jtn"
   ]
  },
  {
   "id": "K_home",
   "type": "established",
   "nature": "fact",
   "text": "Agents watching from a casino parking lot in Winterhaven saw the truck leave the wall and followed it to a garage at a home on West 16th Place in Yuma, Arizona. Narration: 'Agents simply followed it home.'",
   "sources": [
    "brk9",
    "jtn",
    "yuma"
   ]
  },
  {
   "id": "K_cut",
   "type": "established",
   "nature": "fact",
   "text": "22 July 2023: El Centro Sector agents saw an individual cutting the steel border fence nearly five miles from the Calexico port of entry. Narration: 'Then, near Calexico, someone cut the border fence.'",
   "sources": [
    "wt23",
    "kold",
    "fox23",
    "nn23"
   ]
  },
  {
   "id": "K_watch",
   "type": "established",
   "nature": "fact",
   "text": "The agents who saw the fence being cut alerted Mexican authorities (El Centro Sector Foreign Operations Branch to Mexicali's municipal police). Narration: 'But the real Border Patrol was watching.'",
   "sources": [
    "wt23",
    "kold",
    "fox23"
   ]
  },
  {
   "id": "K_found",
   "type": "established",
   "nature": "fact",
   "text": "Mexican authorities (Mexicali police) found the cloned truck and 17 people, who were detained; the truck was seized by Mexico's Attorney General's office. (The Washington Times adds they were later released by a judge.) Narration: 'Mexican police found the fake truck, and 17 people.' Counter '17'.",
   "sources": [
    "wt23",
    "kold",
    "fox23",
    "nn23",
    "ttw23"
   ]
  },
  {
   "id": "K_punch",
   "type": "established",
   "nature": "fact",
   "text": "The truck and the 17 people were stopped on the Mexican side, before crossing into U.S. territory. Narration (the closing line): 'That fake truck never even made it across.'",
   "sources": [
    "nn23",
    "fox23",
    "wt23",
    "hood23"
   ]
  },
  {
   "id": "K_part5",
   "type": "established",
   "nature": "fact",
   "text": "PART 5 TEASE (end card): announced 29-30 January 2020, the longest smuggling tunnel found on the Southwest border (about 4,309 feet, Tijuana toward Otay Mesa, San Diego), with a rail cart system, ventilation, electricity and an entrance elevator. End card 'PART 5: A TUNNEL WITH AN ELEVATOR'.",
   "sources": [
    "ap20",
    "fox20"
   ]
  }
 ],
