 "claims": [
  {
   "id": "M1_ship",
   "type": "established",
   "nature": "fact",
   "text": "The MV Matthew was a Panamanian-flagged bulk carrier. Drawn as a generic bulker: no name, flag or livery. The hook's 'A ship's captain loaded a fortune in cocaine' states the case: its captain pleaded guilty to possession of the cocaine aboard for sale or supply.",
   "sources": [
    "cbs",
    "mex_medevac",
    "it_depart",
    "bn_fear"
   ]
  },
  {
   "id": "M2_load",
   "type": "established",
   "nature": "fact",
   "text": "2,253 kg of cocaine (reported as 2.2 / 2.25 tonnes). Narration: 'Over 2 tonnes' (the digit on the caption, spoken 'two'). Headline 'TWO TONNES OF COCAINE / AND NO CAPTAIN'.",
   "sources": [
    "it_sent",
    "tj_sent",
    "cbs"
   ]
  },
  {
   "id": "M3_value",
   "type": "established",
   "nature": "fact",
   "text": "Worth about EUR 157 million (the gardai's estimate, as reported). Narration: 'worth a hundred and fifty-seven million euros'. Label sub 'Worth about EUR 157m, as reported'.",
   "sources": [
    "it_sent",
    "ie_sent",
    "lbc",
    "cbs",
    "itv"
   ]
  },
  {
   "id": "M4_record",
   "type": "established",
   "nature": "fact",
   "text": "Ireland's largest-ever drug seizure. Label 'IRELAND'S BIGGEST DRUG SEIZURE'.",
   "sources": [
    "it_sent",
    "rte_sent",
    "bn_sent",
    "itv"
   ]
  },
  {
   "id": "M10_boarding",
   "type": "established",
   "nature": "fact",
   "text": "26 September 2023, off the south coast: Army Ranger Wing soldiers boarded the ship from an Air Corps helicopter in heavy seas / treacherous weather. Narration (gotcha): 'In heavy seas, Rangers dropped from a helicopter.' Label 'OFF IRELAND'S SOUTH COAST · 26 SEPT 2023', sub 'Army Rangers board from a helicopter'. Rangers drawn as generic figures with torches, no weapons, no insignia.",
   "sources": [
    "it_df",
    "tj_inside",
    "bn_rangers",
    "mex_board",
    "itv"
   ]
  },
  {
   "id": "M13_name",
   "type": "established",
   "nature": "fact",
   "text": "The captain, Soheil Jelveh, was not on board when the ship was intercepted. Narration: 'But the captain was gone.' Label 'THE CAPTAIN · NOT ON BOARD'.",
   "sources": [
    "it_sent",
    "tj_sent",
    "rte_sent",
    "bn_sent",
    "lbc"
   ]
  },
  {
   "id": "M6_medevac",
   "type": "established",
   "nature": "fact",
   "text": "On 25 September 2023, the day before the boarding, the captain was airlifted off the ship (reported as a medical evacuation), taken to hospital in Waterford and searched by gardai, who found phones and cash. Narration: 'Airlifted off, with cash and phones.' Callout 'CASH AND PHONES', sub 'Found when police searched him'. Label '25 SEPT 2023 · WATERFORD'.",
   "sources": [
    "tj_sent",
    "tj_two",
    "mex_medevac",
    "bn_fear",
    "ie_sent"
   ]
  },
  {
   "id": "M7_fake",
   "type": "established",
   "nature": "fact",
   "text": "The Special Criminal Court accepted that he fled the ship in a fake medical emergency (and found he knew what was going on). Narration: 'The day before, he'd faked an emergency.' Label sub 'The court accepted it was fake'.",
   "sources": [
    "tj_sent",
    "it_sent",
    "bn_fear"
   ]
  },
  {
   "id": "M8_cash",
   "type": "established",
   "nature": "fact",
   "text": "He was found with cash and phones; the amount differs between reports, so no amount is narrated or shown (the bundle on the tray carries no figure).",
   "sources": [
    "bn_fear",
    "tj_sent",
    "mex_medevac"
   ]
  },
  {
   "id": "M14_plea",
   "type": "established",
   "nature": "fact",
   "text": "He pleaded guilty at the Special Criminal Court to possession of cocaine for sale or supply aboard the ship (24-26 Sept 2023). Narration: 'Soheil Jelveh pleaded guilty.' Card 'SPECIAL CRIMINAL COURT', 'THE CAPTAIN · PLEADED GUILTY'.",
   "sources": [
    "bn_fear",
    "it_sent",
    "tj_sent"
   ]
  },
  {
   "id": "M15_namecap",
   "type": "established",
   "nature": "fact",
   "text": "His barrister told the court he was captain in name only, following orders like everyone else (the defence's words, as reported). Narration: 'His barrister called him captain in name only.' Label 'CAPTAIN IN NAME ONLY', sub 'His barrister, as reported'.",
   "sources": [
    "bn_fear",
    "rte_sent",
    "tj_sent"
   ]
  },
  {
   "id": "M16_sentence",
   "type": "established",
   "nature": "fact",
   "text": "4 July 2025, Special Criminal Court: sentenced to 17 and a half years. Narration: 'Seventeen and a half years.' Counter '17½ YEARS'. The callback 'He didn't' (sail) rests on this sentence and on the ship's departure in July 2026.",
   "sources": [
    "it_sent",
    "rte_sent",
    "tj_sent",
    "bn_sent",
    "lbc"
   ]
  },
  {
   "id": "M17_others",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: eight men were sentenced over the seizure, 129 years in total (headline terms reduced for guilty pleas). Card 'EIGHT MEN JAILED / 129 YEARS BETWEEN THEM'.",
   "sources": [
    "it_sent",
    "tj_sent",
    "ie_sent",
    "lbc"
   ]
  },
  {
   "id": "M18_depart",
   "type": "established",
   "nature": "fact",
   "text": "On 17 July 2026 the MV Matthew left Cork Harbour under tow (a dead-ship tow, bound for Varna), after costing the State about EUR 16-17m to keep; Revenue had sold it for a nominal one dollar. He was sentenced to 17½ years in July 2025; no report of an appeal or release was found (searched 25 Oct 2026). Narration (callback): 'This July, the ship left. He didn't.' (The brief's 'sailed' is corrected to 'left': it was towed.) Stamp 'SHIP: GONE · CAPTAIN: 17½ YEARS'.",
   "sources": [
    "it_depart",
    "revenue",
    "mex_gone",
    "it_dollar"
   ]
  }
 ],
