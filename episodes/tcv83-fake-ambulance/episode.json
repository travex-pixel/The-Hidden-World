 "claims": [
  {
   "id": "K_hook",
   "type": "established",
   "nature": "fact",
   "text": "Oct 2014-Jun 2015: a Dutch-run company used second-hand ambulances, with men in paramedic uniforms, to smuggle cocaine, heroin and ecstasy from the Netherlands to Britain. Headline 'A FAKE AMBULANCE / FULL OF COCAINE'; narration 'A fake ambulance. Full of cocaine.' / 'Fake medics. Netherlands to Britain. 45 trips.'",
   "sources": [
    "dutchnews0615",
    "exstar0615",
    "foxap",
    "rt",
    "dutchnews1115"
   ]
  },
  {
   "id": "K_trips",
   "type": "established",
   "nature": "fact",
   "text": "The National Crime Agency identified at least 45 trips over a 14-month period (one AP report says 44). Label '45 TRIPS IN 14 MONTHS · NCA'.",
   "sources": [
    "dutchnews1115",
    "exstar0716",
    "guardianng",
    "ems1"
   ]
  },
  {
   "id": "K_scrap",
   "type": "established",
   "nature": "fact",
   "text": "16 June 2015: NCA officers tracked an ambulance from Harwich, Essex, to a scrapyard in Smethwick, West Midlands, where two men in paramedic uniforms met two others; four were arrested. Narration (gotcha): 'Police tracked it. Straight to a scrapyard.'",
   "sources": [
    "exstar0716",
    "pressreader_dm",
    "rt",
    "exstar0615"
   ]
  },
  {
   "id": "K_193",
   "type": "established",
   "nature": "fact",
   "text": "The seized ambulance held 193 kg of cocaine, 74 kg of heroin and ecstasy behind riveted panels (about 270 kg in all). Counter '193 KG'; narration 'Inside: 193 kilos of cocaine.'",
   "sources": [
    "rt",
    "foxap",
    "exstar0615"
   ]
  },
  {
   "id": "K_fleet",
   "type": "established",
   "nature": "fact",
   "text": "Dutch police then found about ten more ambulances in storage at two yards (Hoofddorp and Zwanenburg).",
   "sources": [
    "dutchnews0615",
    "nltimes25613",
    "exstar0716"
   ]
  },
  {
   "id": "K_sent",
   "type": "established",
   "nature": "fact",
   "text": "Birmingham Crown Court: in December 2015 three Dutch men were jailed for 28, 24 and 18 years (a fourth was cleared); in July 2016 six more men were jailed, the ringleader for 20 years. Label 'Birmingham Crown Court, 2015-16'. Nobody is named on screen.",
   "sources": [
    "foxap",
    "dutchnews1115",
    "exstar1115",
    "bbc_it",
    "exstar0716",
    "ems1"
   ]
  },
  {
   "id": "K_crutches",
   "type": "established",
   "nature": "fact",
   "text": "One gang member posed as a tourist/patient on crutches to make the ambulance look genuine. Callback: 'The patient on crutches? One of the gang.' Label 'THE \"PATIENT\" ON CRUTCHES WAS A SMUGGLER'.",
   "sources": [
    "foxap",
    "dutchnews1115",
    "guardianng"
   ]
  },
  {
   "id": "K_dakar",
   "type": "established",
   "nature": "fact",
   "text": "April 2010: Spanish police seized a truck modified to look like a Dakar Rally support vehicle, carrying the event's publicity and logos, with 814 kg of cocaine in 32 hidden compartments; seven people were arrested in Bilbao, Barcelona and Ibiza; the drugs were bound for Ibiza. Narration 'A fake Dakar Rally truck.' / '814 kilos in 32 hidden compartments.'",
   "sources": [
    "aeat",
    "ultimahora",
    "eluniverso",
    "cooperativa"
   ]
  },
  {
   "id": "K_docked",
   "type": "established",
   "nature": "fact",
   "text": "The truck had been shipped to Argentina for the January 2010 race (1-16 January), was loaded near Buenos Aires and shipped back to Bilbao, where police seized it when it arrived. Narration (gotcha): 'The race ended in January. Police met the truck in Bilbao.'",
   "sources": [
    "autoguide",
    "jalopnik_dakar",
    "cooperativa",
    "eluniverso"
   ]
  },
  {
   "id": "K_coffin",
   "type": "established",
   "nature": "fact",
   "text": "13 December 2024: police stopped a French-registered van on the A29 near Numansdorp for suspicious driving; the 30-year-old driver said the two coffins held bodies but could not show proper paperwork; opened at a funeral home, the coffins held no bodies, only sports bags of cocaine (police: more than 250 kg). Narration 'Then a van with two coffins. Two bodies, he said.' / 'No paperwork. No bodies. Just cocaine.'",
   "sources": [
    "nltimes77111",
    "dutchnews1224",
    "brusselstimes",
    "rechtspraak"
   ]
  },
  {
   "id": "K_coffin_sent",
   "type": "established",
   "nature": "fact",
   "text": "April 2025: the Rotterdam court sentenced the driver to four years in prison and found him guilty of using forged documents (the court gives just over 230 kg; the prosecutor had demanded six years). Narration 'Four years.' Label 'ROTTERDAM COURT, APRIL 2025: 4 YEARS'.",
   "sources": [
    "rechtspraak",
    "om_nl"
   ]
  },
  {
   "id": "K_funfact",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT: the 2007 Dakar was the last run in Africa; the 2008 rally was cancelled days before the start after four French tourists were killed in Mauritania; from 2009 to 2019 it ran in South America and since 2020 in Saudi Arabia. Card: THE 'DAKAR' RALLY HAS NOT REACHED DAKAR SINCE 2007.",
   "sources": [
    "wiki_dakar",
    "aljazeera",
    "britannica"
   ]
  },
  {
   "id": "K_laissez",
   "type": "established",
   "nature": "fact",
   "text": "A corpse crossing a border must travel with a 'laissez-passer for a corpse' issued by the state of departure (Council of Europe Agreement on the Transfer of Corpses, Strasbourg 1973, article 3). Label sub: a body needs a 'laissez-passer' (1973 treaty).",
   "sources": [
    "coe_ets80",
    "wiki_corpses"
   ]
  }
 ],
