  "claims": [
    {
      "id": "C1",
      "type": "illustrative",
      "text": "The story, characters and office are fiction. They dramatise a pattern; they do not prove anything.",
      "sources": []
    },
    {
      "id": "C2",
      "type": "plausible",
      "text": "Retold stories tend to lose detail and get bent toward what listeners expect (classic serial-reproduction rumour studies). The original lab setting differs from real rumour spreading, and some field studies found rumours could become more accurate, so this is a tendency, not a law.",
      "sources": [
        "S1",
        "S2"
      ]
    },
    {
      "id": "C3",
      "type": "established",
      "text": "People tend to search for, interpret and remember information in ways that fit what they already believe (confirmation bias), and a perceiver's expectations can draw out behaviour from the other person that seems to confirm them (behavioural confirmation).",
      "sources": [
        "S3",
        "S4"
      ]
    }
  ],
