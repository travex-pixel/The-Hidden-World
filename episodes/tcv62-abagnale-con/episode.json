 "claims": [
  {
   "id": "F_hook",
   "type": "established",
   "nature": "reported",
   "text": "HOT TAKE (framing, attributed): Frank Abagnale, the best-known self-described con man, inspired a Spielberg film; a 2020 book by researcher Alan C. Logan, based on public records, argues much of his story was invented. Narration: 'Hollywood's favorite conman may have conned Hollywood.' ('may have': the doubts are the researcher's argument and Abagnale disputes them.)",
   "sources": [
    "whyy",
    "boing",
    "wiki",
    "portland",
    "goodreads",
    "ati"
   ]
  },
  {
   "id": "F_film",
   "type": "established",
   "nature": "fact",
   "text": "His 1980 memoir 'Catch Me If You Can' (written with Stan Redding) became Steven Spielberg's 2002 film of the same name. Narration: 'The 2002 hit Catch Me If You Can.'",
   "sources": [
    "wiki",
    "wiki_book",
    "cbs_film",
    "wapo"
   ]
  },
  {
   "id": "F_claims",
   "type": "established",
   "nature": "reported",
   "text": "HIS CLAIMS: he said that as a teenager he posed as a Pan Am pilot (co-pilot), a doctor and a lawyer. Narration: 'He claimed he was a Pan Am pilot, then a doctor.' Label: 'Pan Am pilot, doctor, lawyer (his account)'.",
   "sources": [
    "wiki",
    "wapo",
    "cbs_film",
    "whyy",
    "ati"
   ]
  },
  {
   "id": "F_stat",
   "type": "established",
   "nature": "reported",
   "text": "STATISTIC (counter, HIS claim): Abagnale has said he passed about $2.5 million in forged checks (in 26 countries) between the ages of 16 and 21. Shown as a claim, credited 'His own claim · unverified'. Narration: 'He claimed $2.5 million in bad checks.'",
   "sources": [
    "lvsun",
    "wgbh",
    "whyy",
    "wiki"
   ]
  },
  {
   "id": "F_logan",
   "type": "established",
   "nature": "fact",
   "text": "Alan C. Logan, a researcher and science writer, spent years searching public records (prison, court, newspaper archives; letters) for his 2020 book 'The Greatest Hoax on Earth: Catching Truth, While We Can'. Narration: 'So an author checked the records.'",
   "sources": [
    "whyy",
    "boing",
    "portland",
    "goodreads",
    "wiki"
   ]
  },
  {
   "id": "F_prison",
   "type": "established",
   "nature": "reported",
   "text": "RECORDS (via the researcher): New York State Archives records show Abagnale held at Great Meadow prison, Comstock, New York (inmate 25367) from 26 July 1965 to 24 December 1968, i.e. aged 17 to 20 (born 1948), with a brief parole in 1967 before he was returned. Logan: 'confined for the most part in prison during those years'. Narration: 'What did he find? Prison records, age 17 to 20.'",
   "sources": [
    "wiki",
    "wiki_gm",
    "pretend",
    "attrition",
    "whyy"
   ]
  },
  {
   "id": "F_years",
   "type": "established",
   "nature": "reported",
   "text": "His claimed run of impersonations and check fraud spanned roughly ages 16 to 21 (1964-69), so the prison term covers most of those years (Logan's argument; Abagnale disputes it). Narration: 'His famous con years.'",
   "sources": [
    "whyy",
    "wiki",
    "wiki_gm",
    "lvsun",
    "attrition"
   ]
  },
  {
   "id": "F_book",
   "type": "established",
   "nature": "fact",
   "text": "FUN FACT CARD: the memoir carries its own disclaimer that some events were altered and names, dates and places were changed; Abagnale has said his co-writer dramatised and exaggerated parts of it (paraphrase; the exact website wording was found only second-hand, so it is not quoted). Narration: 'Even his own book says names and dates were changed.'",
   "sources": [
    "wiki",
    "wiki_book",
    "looper",
    "attr_auto"
   ]
  },
  {
   "id": "F_fans",
   "type": "established",
   "nature": "reported",
   "text": "Opinion beat (attributed to fans, not a fact claim): the film and the story remain popular (a hit film and a Broadway musical). Narration: 'His fans say: still a great story.'",
   "sources": [
    "wiki",
    "cbs_film",
    "wapo"
   ]
  },
  {
   "id": "F_records",
   "type": "established",
   "nature": "reported",
   "text": "Opinion beat summarising F_prison: the archive records place him in prison (Great Meadow, 1965-68). Narration: 'Records say: he was behind bars.'",
   "sources": [
    "wiki",
    "wiki_gm",
    "pretend",
    "attrition",
    "whyy"
   ]
  },
  {
   "id": "F_rebuttal",
   "type": "established",
   "nature": "reported",
   "text": "HIS SIDE (label): Abagnale has rejected the doubts; asked about journalists who debunked him, he said the people they spoke to were too embarrassed to admit they had been conned. Label paraphrase: 'He says doubters' sources were too embarrassed to admit being conned'.",
   "sources": [
    "whyy",
    "boing"
   ]
  },
  {
   "id": "F_lesson",
   "type": "established",
   "nature": "fact",
   "text": "LESSON CARD (practical, for the viewer): fake-check scams: a check for more than you are owed with a request to send some back is a scam; a deposited check can show as available and still bounce weeks later, leaving you to repay the bank; no legitimate payer asks you to return money by wire, gift cards, a payment app or crypto (FTC). Rows: 'OVERPAID? IT IS A SCAM', 'CLEARED CAN STILL BOUNCE', 'NEVER SEND THE EXTRA BACK'.",
   "sources": [
    "ftc_fake",
    "ftc_biz",
    "milcon"
   ]
  },
  {
   "id": "F_consult",
   "type": "established",
   "nature": "fact",
   "text": "OUTCOME: Abagnale built a decades-long career as a paid fraud-prevention consultant and speaker (Washington Post 2002: 'now a fraud consultant'; CBS; AARP Fraud Watch Network ambassador from 2015). Narration: 'And the conman? He became a paid fraud consultant.'",
   "sources": [
    "wapo",
    "cbs_tips",
    "assoc",
    "wpm",
    "wiki"
   ]
  }
 ],
