 "claims": [
  {
   "id": "R_heir",
   "type": "established",
   "nature": "fact",
   "text": "Robert Durst was a New York real-estate heir ('scion' of the Durst family). Narration: 'Robert Durst'; label: 'NEW YORK REAL-ESTATE HEIR'.",
   "sources": [
    "bangor_wire",
    "abc7_arrest",
    "csm_arrest",
    "nbc_jinx2"
   ]
  },
  {
   "id": "R_interview",
   "type": "established",
   "nature": "fact",
   "text": "Durst approached the filmmaker after the 2010 feature 'All Good Things' and volunteered to be interviewed for the HBO series 'The Jinx' (THR: about 21 hours of interviews, not stated). Narration: 'Robert Durst offered to do a television interview.'",
   "sources": [
    "thr_jinx2",
    "greenwich_verdict",
    "nbc_jinx2"
   ]
  },
  {
   "id": "R_mic",
   "type": "established",
   "nature": "fact",
   "text": "After the final interview (recorded 18 April 2012) he went to the bathroom still wearing a live microphone and was recorded saying, among other remarks, 'There it is. You're caught.' and 'What the hell did I do? Killed them all, of course.' The finale aired on 15 March 2015. Narration: 'Then he went to the bathroom wearing a live mic.' / 'It caught him: killed them all, of course.' The card says 'wording as reported'.",
   "sources": [
    "abc7_finale",
    "abc7_arrest",
    "cns_tape",
    "ap_audio"
   ]
  },
  {
   "id": "R_edit",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY: a 2019 New York Times report on the unedited transcript showed the bathroom remarks were pulled from a longer sequence of rambling remarks and re-ordered; the filmmakers said they put 'killed them all' last for dramatic effect; the editing came out at trial. Card: 'THE AUDIO WAS LATER SHOWN TO BE RE-ORDERED IN EDITING'.",
   "sources": [
    "spin_edit",
    "newser_edit",
    "buzzfeed_edit",
    "dailybeast_edit",
    "aol_refresher"
   ]
  },
  {
   "id": "R_wife",
   "type": "established",
   "nature": "fact",
   "text": "Kathleen McCormack Durst, his first wife, 29 and a medical student, was last seen on 31 January 1982 (Durst said he put her on a train at South Salem, New York); she was never found. Narration: 'His wife vanished in 1982.' Card: '1982 · HIS WIFE VANISHED · NEVER FOUND'. She is named only on the memorial card.",
   "sources": [
    "nbc_kathie",
    "cbs_kathie",
    "news12_kathie",
    "cnn_indict"
   ]
  },
  {
   "id": "R_berman",
   "type": "established",
   "nature": "fact",
   "text": "Susan Berman, 55, a writer and his close friend (CBS: 'best friend'), was shot dead at her home near Beverly Hills in December 2000, as New York investigators prepared to question her about Kathleen's disappearance. Narration: 'His best friend was shot dead in 2000.' She is named only on the memorial card; nothing of the crime is shown.",
   "sources": [
    "abc7_berman",
    "nbc_hearing",
    "cbs_sentence"
   ]
  },
  {
   "id": "R_note",
   "type": "established",
   "nature": "fact",
   "text": "An anonymous note mailed to Beverly Hills police gave only Berman's address and the word 'CADAVER', in block letters; the envelope misspelled Beverly as 'Beverley'. Narration: 'Police got an anonymous note: cadaver, and her address.' The drawn envelope and note are generic (tag 'NOT THE REAL NOTE'); no address is drawn.",
   "sources": [
    "ap_lawyers",
    "ap_cadaver",
    "ap_closing"
   ]
  },
  {
   "id": "R_denied",
   "type": "established",
   "nature": "fact",
   "text": "Durst denied writing the note for years, to police and to the documentary filmmakers; at trial in August 2021 he admitted writing it but denied the killing. Narration: 'He denied writing it, even to the HBO crew filming him.'",
   "sources": [
    "ap_cadaver",
    "ap_closing",
    "ap_lawyers"
   ]
  },
  {
   "id": "R_letter",
   "type": "established",
   "nature": "fact",
   "text": "The Jinx filmmakers found an earlier letter Durst had sent Berman with nearly identical handwriting and the same 'Beverley' misspelling; confronted with the two side by side he could not tell them apart. A law-enforcement official told AP the handwriting analysis linking the letters was the key new evidence given to prosecutors before his arrest; the prosecutor called the note the 'smoking gun'. Narration: 'The filmmakers found a letter he'd sent her.' / 'Same handwriting, same spelling mistake.'",
   "sources": [
    "ap_lawyers",
    "ap_cadaver",
    "chn_arrest",
    "fox_letter",
    "ap_closing"
   ]
  },
  {
   "id": "R_arrest",
   "type": "established",
   "nature": "fact",
   "text": "FBI agents arrested Durst at a New Orleans hotel on Saturday 14 March 2015, the day before the finale aired, on a Los Angeles warrant for Berman's murder. Narration: 'He was arrested the day before it aired.' Card: 'NEW ORLEANS · 14 MARCH 2015'.",
   "sources": [
    "abc7_arrest",
    "apr_arrest",
    "csm_arrest",
    "nbc_jinx2"
   ]
  },
  {
   "id": "R_tape_trial",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY: the bathroom recording was played to the jury in Los Angeles during opening statements in March 2020; the trial was paused by the pandemic and resumed in May 2021 with the same jury. Card: 'THE LETTER AND THE TAPE WERE BOTH IN EVIDENCE'.",
   "sources": [
    "cns_tape",
    "guardian_open",
    "ap_audio"
   ]
  },
  {
   "id": "R_verdict",
   "type": "established",
   "nature": "fact",
   "text": "A Los Angeles jury convicted Durst of the first-degree murder of Susan Berman, with special circumstances, on 17 September 2021. Narration: 'In 2021 a jury convicted him of his friend's murder.'",
   "sources": [
    "cbs_sentence",
    "rs_sentence",
    "greenwich_verdict",
    "abc13_timeline"
   ]
  },
  {
   "id": "R_sentence",
   "type": "established",
   "nature": "fact",
   "text": "Judge Mark Windham sentenced him to life without the possibility of parole on 14 October 2021. Narration: 'Sentence: life without parole.'",
   "sources": [
    "cbs_sentence",
    "spectrum_sentence",
    "rs_sentence"
   ]
  },
  {
   "id": "R_kathie_charge",
   "type": "established",
   "nature": "fact",
   "text": "A second-degree murder complaint over Kathleen's death was filed in Lewisboro Town Court on 19 October 2021 and a Westchester County grand jury indictment was reported on 1 November 2021. Narration: 'charged with his wife's murder too'. Card: 'OCT-NOV 2021'.",
   "sources": [
    "cnn_indict",
    "oxygen_charge",
    "avpress_charge"
   ]
  },
  {
   "id": "R_death",
   "type": "established",
   "nature": "fact",
   "text": "Durst died of natural causes in custody (at an outside hospital, per the California corrections department) on 10 January 2022, aged 78, while awaiting trial on the Kathleen charge; that case never went to trial. Narration: 'He died in custody in 2022'. Card: 'THAT CASE NEVER WENT TO TRIAL'.",
   "sources": [
    "abc6_death",
    "abc30_death",
    "cnn_indict"
   ]
  },
  {
   "id": "R_victims",
   "type": "established",
   "nature": "fact",
   "text": "CARD ONLY (memorial): Kathleen McCormack Durst (29 when last seen in 1982) and Susan Berman (55, killed in 2000). Narration: 'We remember them both.'",
   "sources": [
    "nbc_kathie",
    "abc7_berman",
    "cbs_sentence"
   ]
  }
 ],
