  "claims": [
    {
      "id": "C1",
      "type": "established",
      "text": "Microwaves are reflected by metal; they pass through glass, paper and plastic and are absorbed by food (FDA).",
      "sources": [
        "S1"
      ]
    },
    {
      "id": "C2",
      "type": "established",
      "text": "Household ovens run at about 2.45 GHz, so the wavelength is c/f ≈ 12.2 cm; the waves reflect off the metal interior.",
      "sources": [
        "S1",
        "S2",
        "S3"
      ]
    },
    {
      "id": "C3",
      "type": "established",
      "text": "The door screen is a conducting mesh with holes of roughly 1–2 mm; a conducting surface with holes much smaller than the wavelength reflects the wave, as if solid.",
      "sources": [
        "S3",
        "S4"
      ]
    },
    {
      "id": "C4",
      "type": "established",
      "text": "Visible light has wavelengths of about 0.4–0.7 µm, thousands of times smaller than the holes, so it passes through.",
      "sources": [
        "S3",
        "S4"
      ]
    },
    {
      "id": "C5",
      "type": "established",
      "text": "Common Wi-Fi (802.11b/g/n) uses the same 2.4 GHz band; ovens leak a small amount, within the legal limit, which can swamp nearby Wi-Fi.",
      "sources": [
        "S5",
        "S6"
      ]
    },
    {
      "id": "C6",
      "type": "established",
      "text": "US federal standard 21 CFR 1030.10 limits lifetime leakage to 5 mW/cm² at about 2 inches from the surface, far below levels known to harm people (FDA).",
      "sources": [
        "S1"
      ]
    },
    {
      "id": "C7",
      "type": "established",
      "text": "The metal cavity, door and mesh together form a Faraday cage that keeps the microwaves inside.",
      "sources": [
        "S4",
        "S7"
      ]
    }
  ],
