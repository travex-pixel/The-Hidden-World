  "claims": [
    {
      "id": "C1",
      "type": "illustrative",
      "text": "The story and characters are fiction. They dramatise a pattern; they do not prove anything.",
      "sources": []
    },
    {
      "id": "C2",
      "type": "established",
      "text": "People who anxiously expect rejection tend to read rejection into ambiguous behaviour (Downey & Feldman, 1996), and can behave in ways that draw out the rejection they feared (Downey et al., 1998). Those studies were about romantic partners; the office story is an illustration.",
      "sources": [
        "S1",
        "S2"
      ]
    },
    {
      "id": "C3",
      "type": "established",
      "text": "Hostile attribution bias: reading hostile intent into ambiguous actions (meta-analysis in children: Orobio de Castro et al., 2002).",
      "sources": [
        "S3"
      ]
    }
  ],
  "sources": [
    {
      "id": "S1",
