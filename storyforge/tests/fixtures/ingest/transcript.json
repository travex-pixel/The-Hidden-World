  "segments": [
    {"speaker": "Maya Chen", "startTime": 0.0, "endTime": 1.4, "body": "Welcome back"},
    {"speaker": "Maya Chen", "startTime": 1.4, "endTime": 2.9, "body": "to The Hidden Ledger."},
    {"speaker": "Maya Chen", "startTime": 2.9, "endTime": 6.1, "body": "Today we are in Atlanta,"},
    {"speaker": "Maya Chen", "startTime": 6.1, "endTime": 9.8, "body": "June 1979,"},
    {"speaker": "Maya Chen", "startTime": 9.8, "endTime": 14.2, "body": "standing outside a very empty store."},
    {"speaker": "Maya Chen", "startTime": 14.2, "endTime": 17.5, "body": "Tom, who is at the door?"},
    {"speaker": "Tom Okafor", "startTime": 17.9, "endTime": 21.0, "body": "Two men"},
    {"speaker": "Tom Okafor", "startTime": 21.0, "endTime": 24.6, "body": "with a stack of dollar bills"},
    {"speaker": "Tom Okafor", "startTime": 24.6, "endTime": 27.3, "body": "handing them to strangers."},
    {"speaker": "Maya Chen", "startTime": 27.6, "endTime": 29.0, "body": "That is the marketing plan?"},
    {"speaker": "Tom Okafor", "startTime": 29.2, "endTime": 31.8, "body": "That is the entire marketing plan."}
  ]
}
